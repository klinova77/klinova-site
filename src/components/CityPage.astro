  <!-- Script pour gérer le sélecteur de fichiers -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const photosInput = document.getElementById('photos-input');
      const photosDropZone = document.getElementById('photos-drop-zone');
      const photosStatus = document.getElementById('photos-status');
      const photosList = document.getElementById('photos-list');
      const photosHidden = document.getElementById('photos-hidden');

      if (!photosInput || !photosDropZone || !photosStatus) return;

      // Fonction pour ouvrir le sélecteur de fichiers
      function openFileSelector() {
        photosInput.click();
      }

      // Gestionnaire de clic sur la zone de drop
      photosDropZone.addEventListener('click', openFileSelector);

      // Gestionnaire de changement de fichiers
      photosInput.addEventListener('change', function(e) {
        const files = Array.from(e.target.files);
        handleFiles(files);
      });

      // Gestionnaire drag & drop
      photosDropZone.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.stopPropagation();
        photosDropZone.classList.add('border-[#3F8D65]', 'bg-[#F8FBF9]');
      });

      photosDropZone.addEventListener('dragleave', function(e) {
        e.preventDefault();
        e.stopPropagation();
        photosDropZone.classList.remove('border-[#3F8D65]', 'bg-[#F8FBF9]');
      });

      photosDropZone.addEventListener('drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        photosDropZone.classList.remove('border-[#3F8D65]', 'bg-[#F8FBF9]');
        
        const files = Array.from(e.dataTransfer.files).filter(file => 
          file.type.startsWith('image/')
        );
        
        if (files.length > 0) {
          // Mettre à jour l'input file
          const dt = new DataTransfer();
          files.slice(0, 4).forEach(file => dt.items.add(file)); // Max 4 photos
          photosInput.files = dt.files;
          handleFiles(files.slice(0, 4));
        }
      });

      // Fonction pour gérer les fichiers sélectionnés
      function handleFiles(files) {
        if (files.length === 0) {
          photosStatus.textContent = 'Aucune photo';
          photosList.classList.add('hidden');
          return;
        }

        const fileCount = Math.min(files.length, 4);
        photosStatus.textContent = `${fileCount} photo(s) sélectionnée(s)`;
        
        // Afficher la liste des fichiers
        photosList.innerHTML = '';
        photosList.classList.remove('hidden');
        
        files.slice(0, 4).forEach((file, index) => {
          const fileItem = document.createElement('div');
          fileItem.className = 'flex items-center justify-between bg-[#F8FAFC] rounded p-2 text-sm';
          
          const fileName = file.name.length > 30 ? 
            file.name.substring(0, 30) + '...' : file.name;
          
          const fileSize = (file.size / (1024 * 1024)).toFixed(2);
          
          fileItem.innerHTML = `
            <span class="text-[#475569]">${fileName} (${fileSize} MB)</span>
            <button type="button" class="text-red-500 hover:text-red-700" onclick="removeFile(${index})">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          `;
          
          photosList.appendChild(fileItem);
        });
      }

      // Fonction pour supprimer un fichier (à définir globalement)
      window.removeFile = function(index) {
        const files = Array.from(photosInput.files);
        files.splice(index, 1);
        
        const dt = new DataTransfer();
        files.forEach(file => dt.items.add(file));
        photosInput.files = dt.files;
        
        handleFiles(files);
      };
    });
  </script>
)}




