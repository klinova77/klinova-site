          Merci à nos clients qui nous ont fait confiance&nbsp;!
        </h3>

        <div class="skReviewsWrap">
          <div class="sk-ww-google-reviews" data-embed-id="25566122">
            <p>Chargement des avis Google…</p>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        const SCRIPT_SRC = "https://widgets.sociablekit.com/google-reviews/widget.js";
        const target = document.querySelector(".sk-ww-google-reviews");
        if (!target) return;

        const injectOnce = () => {
          if (window.__SK_WIDGET_SCRIPT_LOADED) return;
          window.__SK_WIDGET_SCRIPT_LOADED = true;
          if (document.querySelector(`script[src="${SCRIPT_SRC}"]`)) return;

          const s = document.createElement("script");
          s.src = SCRIPT_SRC;
          s.defer = true;
          document.body.appendChild(s);
        };

        if (!("IntersectionObserver" in window)) {
          injectOnce();
          return;
        }

        const obs = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              injectOnce();
              obs.disconnect();
            }
          },
          { rootMargin: "250px 0px" }
        );

        obs.observe(target);
      })();
    </script>

    <style>
      .skReviewsWrap {
        max-height: 340px;
        overflow: auto;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 8px;
        background: #fff;
      }
      @media (max-width: 640px) {
        .skReviewsWrap {
          max-height: 260px;
          padding: 6px;
        }
      }
    </style>
  </section>
