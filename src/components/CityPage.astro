---
// src/components/CityPage.astro - Version Premium Conversion/SEO Optimisée

import LayoutWithCTA from '~/layouts/LayoutWithCTA.astro';
import type { City, CityServiceLocal, ServiceConfig, Department } from '~/types/geo';

// 🗂️ Data imports
import citiesIndex from '~/data/cities';

// 🖼️ Assets Hero fallbacks
import heroParkingsDesktop from '~/assets/images/nettoyage-parking-professionnel-paris.webp';
import heroParkingsMobile  from '~/assets/images/nettoyage-parking-professionnel-paris.webp';
import heroBalconsDesktop  from '~/assets/images/Klinova_nettoyage_balcon_soigne.png';
import heroBalconsMobile   from '~/assets/images/Klinova_nettoyage_balcon_soigne.png';

interface Props {
  city: City;
  service: ServiceConfig;
  department: Department;
}

const { city, service, department } = Astro.props as Props;

// Utils
const slugify = (v: string) =>
  v
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');

type ImgLike = string | { src: string };
const toSrc = (x?: ImgLike) => (typeof x === 'string' ? x : x?.src || '');

// Slugs & canonical
const citySlug = city.slug ?? slugify(city.name);
const departmentSlug = department.slug ?? slugify(department.name);
const canonical = `/zones-d-intervention/${departmentSlug}/${citySlug}/${service.key}`;

// Service note spécifique ville
const cityNote: CityServiceLocal | undefined =
  Array.isArray(city.services)
    ? city.services.find((s: CityServiceLocal) => s.serviceKey === service.key)
    : undefined;

// Résolution des villes proches à partir de city.nearbyCities
const nearbyCitiesResolved =
  city.nearbyCities && city.nearbyCities.length > 0
    ? (city.nearbyCities
        .map((slug) => {
          const found = (citiesIndex as City[]).find((c) => (c.slug ?? slugify(c.name)) === slug);
          if (!found) return null;
          const s = found.slug ?? slugify(found.name);
          const deptSlug = found.department?.slug ?? departmentSlug;
          return { name: found.name, slug: s, deptSlug };
        })
        .filter((c) => c !== null) as { name: string; slug: string; deptSlug: string }[])
    : [];

// Autres villes pour maillage horizontal (hors ville actuelle et hors nearbyCities)
const excludeSlugs = new Set<string>([
  citySlug,
  ...(city.nearbyCities ?? []),
]);

const otherCitiesForService = (citiesIndex as City[])
  .filter((c) => !excludeSlugs.has(c.slug ?? slugify(c.name)))
  .slice(0, 6)
  .map((c) => {
    const slug = c.slug ?? slugify(c.name);
    const deptForC = c.department?.slug ?? departmentSlug;
    return { name: c.name, slug, deptSlug: deptForC };
  });

// Images hero par service
type ServiceKey = 'moquettes' | 'parkings' | 'balcons' | 'balcons-fientes' | 'canapes-tapis';
const heroFallback: Record<ServiceKey, { desktop: ImgLike; mobile: ImgLike }> = {
  moquettes: {
    desktop: '/images/nettoyage-moquette-avant-apres.webp',
    mobile: '/images/nettoyage-moquette-avant-apres-mobile.webp',
  },
  parkings: { desktop: heroParkingsDesktop, mobile: heroParkingsMobile },
  balcons: { desktop: heroBalconsDesktop, mobile: heroBalconsMobile },
  'balcons-fientes': { desktop: heroBalconsDesktop, mobile: heroBalconsMobile },
  'canapes-tapis': {
    desktop: '/images/nettoyage-canape-tapis.webp',
    mobile: '/images/nettoyage-canape-tapis-mobile.webp',
  },
};

const heroDesktop =
  service.images?.heroDesktop ??
  city.images?.heroDesktop ??
  toSrc(heroFallback[service.key as ServiceKey]?.desktop ?? '/images/default-hero.webp');

const heroMobile =
  service.images?.heroMobile ??
  city.images?.heroMobile ??
  toSrc(heroFallback[service.key as ServiceKey]?.mobile ?? '/images/default-hero-mobile.webp');

// URLs service parent
const serviceUrl =
  service.urls?.parent ??
  ((
    {
      moquettes: '/nettoyage-moquettes',
      parkings: '/nettoyage-parkings',
      balcons: '/nettoyage-balcons',
      'balcons-fientes': '/nettoyage-balcons#fientes-pigeons',
      'canapes-tapis': '/nettoyage-canapes-tapis',
    } as Record<string, string>
  )[service.key] ?? '/');

// SEO optimisé
const pageTitle = `${service.name} à ${city.name} | Intervention Professionnelle – Klinova`;
const description =
  city.customDescription
    ? `${service.name} à ${city.name} – ${city.customDescription}`
    : service.defaultDescription
      ? `${service.defaultDescription} Intervention à ${city.name} et en Île-de-France.`
      : `${service.name} professionnel à ${city.name} pour copropriétés et gestionnaires exigeants.`;

// Contenu dynamique
const ctaLabel = cityNote?.ctaOverride ?? city.ctaOverride ?? 'Demander un devis gratuit';
const serviceLabel = `${service.name} – ${city.name}`;

// Verbes par service pour CTA naturel
const serviceVerbs: Record<string, string> = {
  moquettes: 'nettoyer',
  parkings: 'entretenir',
  balcons: 'rénover',
  'balcons-fientes': 'désinfecter',
  'canapes-tapis': 'assainir',
};

// Benefits (non affichés pour l’instant mais dispo si besoin)
const serviceBenefits = service.benefits ?? [
  'Intervention rapide et planifiée',
  'Matériel professionnel adapté',
  'Respect des normes environnementales',
  'Devis transparent et détaillé',
];

// Process avec fallback
const defaultProcess = [
  {
    step: 'Diagnostic',
    description: 'Évaluation des surfaces et identification des besoins spécifiques.',
  },
  {
    step: 'Intervention',
    description: 'Nettoyage professionnel avec équipement adapté.',
  },
  {
    step: 'Contrôle qualité',
    description: 'Vérification du résultat et compte-rendu détaillé.',
  },
];
const serviceProcess = service.process ?? defaultProcess;

// FAQ combinée : service + ville + additions locales
const combinedFaq = [
  ...(service.faq ?? []),
  ...(city.faq ?? []),
  ...(cityNote?.faqAdditions ?? []),
];


// JSON-LD optimisé
const baseUrl = import.meta.env.SITE ?? 'https://klinova.fr';

const faqEntities = [
  ...(service.faq ?? []).map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
  ...(city.faq ?? []).map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
  ...(cityNote?.faqAdditions ?? []).map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: "Zones d'intervention",
      item: `${baseUrl}/zones-d-intervention`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: city.name,
      item: `${baseUrl}/zones-d-intervention/${departmentSlug}/${citySlug}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: service.name,
      item: `${baseUrl}${canonical}`,
    },
  ],
};

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Klinova',
  url: 'https://klinova.fr',
  telephone: '+33676738661',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6 rue d\'Armaillé',
    addressLocality: 'Paris',
    postalCode: '75017',
    addressCountry: 'FR',
  },
  priceRange: service.pricing ? `À partir de ${service.pricing.from}` : '$$',
  areaServed: {
    '@type': 'Place',
    name: city.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: city.name,
      postalCode: city.postalCodes?.[0],
      addressCountry: 'FR',
    },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: service.name,
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: `${service.name} à ${city.name}`,
          description,
        },
      },
    ],
  },
};

// HowTo basé sur le process (optionnel)
const howToJsonLd =
  serviceProcess && serviceProcess.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'HowTo',
        name: `${service.name} à ${city.name} – protocole d'intervention`,
        description,
        step: serviceProcess.map((step, index) => ({
          '@type': 'HowToStep',
          position: index + 1,
          name: step.step,
          itemListElement: [
            {
              '@type': 'HowToDirection',
              text: step.description,
            },
          ],
        })),
      }
    : null;

const jsonLd: any[] = [
  localBusinessJsonLd,
  breadcrumbJsonLd,
  ...(faqEntities.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faqEntities,
        },
      ]
    : []),
  ...(howToJsonLd ? [howToJsonLd] : []),
];

// Aides pour pricingHint
const pricingHintEntries =
  cityNote?.pricingHint
    ? Object.entries(cityNote.pricingHint).filter(([key]) => key !== 'note')
    : [];

const pricingHintNote = cityNote?.pricingHint && 'note' in cityNote.pricingHint
  ? (cityNote.pricingHint as any).note
  : undefined;

const caseStudy = cityNote?.caseStudy;
const photos = cityNote?.photos ?? [];
---

<LayoutWithCTA
  title={pageTitle}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  popupContext={{
    title: 'Demande de devis',
    subtitle: 'Un expert Klinova vous répond sous 2h',
    serviceKey: service.key,
    serviceLabel,
    trackingSource: `citypage-${service.key}-${citySlug}`,
  }}
>
  <!-- Preload hero images -->
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={heroDesktop}
      fetchpriority="high"
      media="(min-width:768px)"
    />
    <link
      rel="preload"
      as="image"
      href={heroMobile}
      fetchpriority="high"
      media="(max-width:767px)"
    />
  </Fragment>

  <main class="min-h-[70vh] bg-neutral-50">
    <!-- 🧭 Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="bg-white border-b border-neutral-200">
      <div class="container-responsive py-3">
        <ol class="flex flex-wrap gap-2 text-sm text-neutral-600">
          <li>
            <a href="/" class="hover:text-primary-600 transition-colors">Accueil</a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li>
            <a href="/zones-d-intervention" class="hover:text-primary-600 transition-colors">
              Zones d'intervention
            </a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li>
            <a
              href={`/zones-d-intervention/${departmentSlug}/${citySlug}`}
              class="hover:text-primary-600 transition-colors"
            >
              {city.name}
            </a>
          </li>
          <li aria-hidden="true" class="text-neutral-400">/</li>
          <li aria-current="page" class="font-medium text-primary-600">
            {service.name}
          </li>
        </ol>
      </div>
    </nav>

    <!-- 1️⃣ Hero local (image + H1 + CTA) -->
    <section
      class="relative isolate min-h-[60vh] md:min-h-[70vh] flex items-center justify-center overflow-hidden"
    >
      <div class="absolute inset-0 z-0">
        <picture class="absolute inset-0 block">
          <source media="(min-width:768px)" srcset={heroDesktop} />
          <img
            src={heroMobile}
            alt={`${service.name} professionnel à ${city.name} par Klinova`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </picture>
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/25 to-transparent z-[1]"
          aria-hidden="true"
        ></div>
      </div>

      <div class="relative z-10 text-center px-6 md:px-12 max-w-5xl mx-auto">
        <div
          class="inline-flex items-center px-4 py-2 bg-[#3F8D65]/20 backdrop-blur-sm rounded-full text-sm font-medium mb-6 text-white/90"
        >
          <span class="w-2 h-2 bg-[#3F8D65] rounded-full mr-2 animate-pulse"></span>
          {department.name} • Intervention professionnelle
        </div>

        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-bold text-white drop-shadow-lg leading-tight mb-6"
        >
          <span class="block">{service.name}</span>
          <span class="block text-[#3F8D65]">à {city.name}</span>
        </h1>

        {city.customDescription && (
          <p
            class="text-lg md:text-xl text-white/95 mb-8 max-w-3xl mx-auto leading-relaxed"
          >
            {city.customDescription}
          </p>
        )}

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="#contact-form"
            data-open-popup
            class="group relative inline-flex items-center px-8 py-4 bg-[#3F8D65] text-white font-semibold rounded-xl shadow-xl overflow-hidden transition-all duration-300 hover:bg-[#387B58] hover:shadow-2xl hover:-translate-y-1"
          >
            <span
              class="absolute inset-0 w-0 bg-gradient-to-r from-transparent via-white/20 to-transparent skew-x-12 group-hover:w-full transition-all duration-700"
            ></span>
            <span class="relative z-10">{ctaLabel}</span>
            <svg
              class="ml-2 w-5 h-5 relative z-10 transition-transform group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              ></path>
            </svg>
          </a>

          <a
            href="tel:+33676738661"
            class="group inline-flex items-center px-6 py-4 border-2 border-white/30 text-white font-medium rounded-xl backdrop-blur-sm transition-all duration-300 hover:bg-white/10 hover:border-white/50"
          >
            <svg
              class="w-5 h-5 mr-2 transition-transform group-hover:rotate-12"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            06 76 73 86 61
          </a>
        </div>
      </div>
    </section>

    <!-- 2️⃣ Intro locale (uniqueIntro) -->
    {cityNote?.uniqueIntro && (
      <section class="bg-white section-padding border-b border-neutral-100">
        <div class="container-responsive">
          <div class="max-w-6xl mx-auto">
            <div
              class="prose prose-lg prose-slate max-w-none"
              set:html={cityNote.uniqueIntro}
            />
          </div>
        </div>
      </section>
    )}

    <!-- 3️⃣ Contexte local & quartiers desservis -->
    {(city.districts || city.landmarks || city.specificChallenges) && (
      <section class="bg-neutral-50 section-padding border-b border-neutral-100">
        <div class="container-responsive">
          <div class="max-w-6xl mx-auto grid gap-8 md:grid-cols-2">
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-4">
                Klinova à {city.name}
              </h2>
              <p class="text-neutral-600 mb-4 text-lg">
                Nous intervenons régulièrement à {city.name} pour des copropriétés, syndics
                et gestionnaires exigeants. Nos protocoles tiennent compte des spécificités
                locales et des contraintes de vos immeubles.
              </p>

              {city.specificChallenges && city.specificChallenges.length > 0 && (
                <ul class="mt-4 space-y-2 text-neutral-700">
                  {city.specificChallenges.map((item) => (
                    <li class="flex gap-2">
                      <span class="mt-[6px] h-1.5 w-1.5 rounded-full bg-[#3F8D65]"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            {(city.districts || city.landmarks) && (
              <div class="space-y-6">
                {city.districts && city.districts.length > 0 && (
                  <div>
                    <h3 class="text-lg font-semibold text-primary-600 mb-2">
                      Quartiers où nous intervenons
                    </h3>
                    <div class="flex flex-wrap gap-2">
                      {city.districts.map((q) => (
                        <span
                          class="inline-flex items-center rounded-full border border-neutral-200 bg-white px-3 py-1 text-sm text-neutral-700"
                        >
                          {q}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {city.landmarks && city.landmarks.length > 0 && (
                  <div>
                    <h3 class="text-lg font-semibold text-primary-600 mb-2">
                      Repères locaux
                    </h3>
                    <ul class="space-y-1 text-sm text-neutral-700">
                      {city.landmarks.map((l) => (
                        <li>• {l}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- 4️⃣ Process ou promesse locale -->
    <section class="bg-neutral-50 section-padding">
      <div class="container-responsive">
        <div class="max-w-4xl mx-auto">
          <h2
            class="text-3xl md:text-4xl font-bold text-center text-primary-600 mb-4"
          >
            Notre méthode à {city.name}
          </h2>
          <p
            class="text-center text-neutral-600 text-lg mb-12 max-w-2xl mx-auto"
          >
            Un processus éprouvé et transparent adapté aux spécificités de vos
            immeubles à {city.name}.
          </p>

          <div class="space-y-8">
            {serviceProcess.map((item, index) => (
              <div class="flex gap-6 items-start">
                <div
                  class="flex-shrink-0 w-14 h-14 rounded-full bg-gradient-to-br from-[#3F8D65] to-[#48a674] text-white font-bold flex items-center justify-center text-xl shadow-lg"
                >
                  {index + 1}
                </div>
                <div class="flex-1 pt-2">
                  <h3 class="text-xl font-semibold text-primary-600 mb-3">
                    {item.step}
                  </h3>
                  <p class="text-neutral-600 leading-relaxed text-lg">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>

          {service.averageDuration && (
            <div
              class="mt-12 p-6 rounded-xl bg-gradient-to-r from-green-50 to-emerald-50 border border-green-100 text-center"
            >
              <p class="text-primary-600 text-lg">
                <span class="font-semibold">Durée moyenne d'intervention :</span>{' '}
                {service.averageDuration}
              </p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- 5️⃣ Bloc repères tarifaires locaux -->
    {pricingHintEntries.length > 0 && (
      <section class="bg-white section-padding border-y border-neutral-100">
        <div class="container-responsive">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-4">
              Repères tarifaires à {city.name}
            </h2>
            <p class="text-neutral-600 mb-6">
              Ces indications ont pour but de vous donner un ordre d'idée selon les
              cas les plus fréquents à {city.name}. Un devis précis reste établi
              après analyse de votre situation.
            </p>

            <div class="grid gap-4 md:grid-cols-2">
              {pricingHintEntries.map(([label, value]) => (
                <div
                  class="rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3"
                >
                  <p class="text-sm font-semibold text-primary-600 mb-1">
                    {label}
                  </p>
                  <p class="text-neutral-700 text-sm">{value}</p>
                </div>
              ))}
            </div>

            {pricingHintNote && (
              <p class="mt-4 text-sm text-neutral-600 italic">
                {pricingHintNote}
              </p>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- 6️⃣ Étude de cas locale -->
    {caseStudy && (
      <section class="bg-neutral-50 section-padding border-b border-neutral-100">
        <div class="container-responsive">
          <div class="max-w-5xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-6">
              Étude de cas à {city.name}
            </h2>
            <div
              class="rounded-2xl bg-white border border-neutral-200 p-6 md:p-8 shadow-sm"
            >
              {caseStudy.title && (
                <h3 class="text-xl font-semibold text-primary-600 mb-4">
                  {caseStudy.title}
                </h3>
              )}

              <div class="grid gap-6 md:grid-cols-2">
                {caseStudy.context && (
                  <div>
                    <p class="text-sm font-semibold text-neutral-500 mb-1">
                      Contexte
                    </p>
                    <p class="text-neutral-700 text-sm leading-relaxed">
                      {caseStudy.context}
                    </p>
                  </div>
                )}
                {caseStudy.challenge && (
                  <div>
                    <p class="text-sm font-semibold text-neutral-500 mb-1">
                      Enjeux
                    </p>
                    <p class="text-neutral-700 text-sm leading-relaxed">
                      {caseStudy.challenge}
                    </p>
                  </div>
                )}
              </div>

              <div class="grid gap-6 md:grid-cols-2 mt-6">
                {caseStudy.solution && (
                  <div>
                    <p class="text-sm font-semibold text-neutral-500 mb-1">
                      Notre intervention
                    </p>
                    <p class="text-neutral-700 text-sm leading-relaxed">
                      {caseStudy.solution}
                    </p>
                  </div>
                )}
                {caseStudy.results && (
                  <div>
                    <p class="text-sm font-semibold text-neutral-500 mb-1">
                      Résultat
                    </p>
                    <p class="text-neutral-700 text-sm leading-relaxed">
                      {caseStudy.results}
                    </p>
                  </div>
                )}
              </div>

              {caseStudy.metrics && caseStudy.metrics.length > 0 && (
                <div class="mt-6 border-t border-neutral-100 pt-4">
                  <p class="text-sm font-semibold text-neutral-500 mb-2">
                    Indicateurs clés
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {caseStudy.metrics.map((m) => (
                      <span
                        class="inline-flex items-center rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-700"
                      >
                        {m}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 7️⃣ Galerie locale (si photos) -->
    {photos.length > 0 && (
      <section class="bg-white section-padding border-b border-neutral-100">
        <div class="container-responsive">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-4">
              Exemples d'interventions à {city.name}
            </h2>
            <p class="text-neutral-600 mb-6">
              Quelques vues d'interventions réalisées récemment à {city.name} pour{' '}
              {service.name.toLowerCase()}.
            </p>
            <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
              {photos.map((src) => (
                <figure class="overflow-hidden rounded-xl border border-neutral-200 bg-neutral-100">
                  <img
                    src={src}
                    loading="lazy"
                    decoding="async"
                    alt={`${service.name} à ${city.name} – exemple d'intervention`}
                    class="h-48 w-full object-cover transition-transform duration-300 hover:scale-105"
                  />
                </figure>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 8️⃣ CTA intermédiaire -->
    <section class="bg-gradient-to-r from-[#3F8D65] to-[#48a674] py-12">
      <div class="container-responsive text-center">
        <h3 class="text-2xl md:text-3xl font-bold text-white mb-6">
          Besoin d'une intervention rapide à {city.name} ?
        </h3>
        <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">
          Contactez-nous dès maintenant pour un devis gratuit et personnalisé.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#contact-form"
            data-open-popup
            class="inline-flex items-center px-8 py-4 bg-white text-[#3F8D65] font-semibold rounded-xl shadow-xl hover:bg-neutral-50 transition-all duration-300"
          >
            {ctaLabel}
            <svg
              class="ml-2 w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              ></path>
            </svg>
          </a>
          <a
            href="tel:+33676738661"
            class="inline-flex items-center px-6 py-4 border-2 border-white text-white font-medium rounded-xl hover:bg-white/10 transition-all duration-300"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            06 76 73 86 61
          </a>
        </div>
      </div>
    </section>

    <!-- 9️⃣ Avis / témoignage local -->
    {city.testimonial && (
      <section class="bg-white section-padding">
        <div class="container-responsive">
          <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-8">
              Avis de nos clients à {city.name}
            </h2>
            <div
              class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-8 md:p-12 border border-green-100"
            >
              <div class="text-6xl text-[#3F8D65] mb-6">"</div>
              <blockquote
                class="text-xl md:text-2xl text-primary-600 font-medium mb-8 leading-relaxed italic"
              >
                {city.testimonial.text}
              </blockquote>
              <div class="space-y-2">
                <p class="font-bold text-primary-600 text-lg">
                  {city.testimonial.author}
                </p>
                <p class="text-neutral-600">{city.testimonial.role}</p>
                {city.testimonial.building && (
                  <p class="text-sm text-neutral-500">
                    {city.testimonial.building} – {city.name}
                  </p>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 🔁 Section "À proximité" (nearbyCities) -->
    {nearbyCitiesResolved.length > 0 && (
      <section class="bg-neutral-50 section-padding">
        <div class="container-responsive">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-4">
              Interventions à proximité de {city.name}
            </h2>
            <p class="text-neutral-600 mb-8">
              Nous intervenons aussi dans les communes voisines, avec les mêmes
              standards de qualité Klinova.
            </p>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {nearbyCitiesResolved.map((c) => (
                <a
                  href={`/zones-d-intervention/${c.deptSlug}/${c.slug}/${service.key}`}
                  class="group block rounded-xl border border-neutral-200 bg-white px-6 py-4 hover:border-[#3F8D65] hover:bg-green-50 transition-all duration-200"
                >
                  <div class="flex items-center justify-between gap-2">
                    <span
                      class="font-medium text-primary-600 group-hover:text-[#3F8D65]"
                    >
                      {service.name} à {c.name}
                    </span>
                    <svg
                      class="w-5 h-5 text-[#3F8D65] group-hover:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      ></path>
                    </svg>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 🔁 Section maillage horizontal global -->
    {otherCitiesForService.length > 0 && (
      <section class="bg-white section-padding border-y border-neutral-100">
        <div class="container-responsive">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-4 text-center">
              Autres villes où nous intervenons
            </h2>
            <p class="text-center text-neutral-600 mb-10">
              Klinova intervient dans de nombreuses communes d'Île-de-France.
            </p>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {otherCitiesForService.map((c) => (
                <a
                  href={`/zones-d-intervention/${c.deptSlug}/${c.slug}/${service.key}`}
                  class="group block rounded-xl border border-neutral-200 bg-neutral-50 px-6 py-4 hover:border-[#3F8D65] hover:bg-green-50 transition-all duration-200"
                >
                  <div class="flex items-center justify-between">
                    <span
                      class="font-medium text-primary-600 group-hover:text-[#3F8D65]"
                    >
                      {service.name} à {c.name}
                    </span>
                    <svg
                      class="w-5 h-5 text-[#3F8D65] group-hover:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      ></path>
                    </svg>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 🔎 Bloc info + lien vers la page service principale -->
    <section class="bg-white section-padding border-y border-neutral-100">
      <div class="container-responsive">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-4">
            Notre expertise complète en {service.name.toLowerCase()}
          </h2>
          <p class="text-neutral-600 text-lg mb-8 leading-relaxed">
            Pour mieux comprendre notre approche détaillée, nos certifications et toutes
            les garanties que nous proposons, découvrez notre page dédiée au service.
          </p>
          <a
            href={serviceUrl}
            class="inline-flex items-center px-8 py-4 bg-neutral-100 text-primary-600 font-semibold rounded-xl hover:bg-neutral-200 transition-all duration-300 group"
          >
            Voir notre expertise complète
            <svg
              class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ❓ FAQ locale -->
   {combinedFaq.length > 0 && (
  <section class="bg-neutral-50 section-padding">
    <div class="container-responsive">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-primary-600 mb-4">
          Questions fréquentes
        </h2>
        <p class="text-center text-neutral-600 mb-12 text-lg">
          Tout ce qu'il faut savoir sur {service.name.toLowerCase()} à {city.name}
        </p>

        <div class="space-y-4">
          {combinedFaq.map((item) => (
            <details class="group border border-neutral-200 rounded-xl px-6 py-4 bg-white hover:border-[#3F8D65] hover:bg-green-50 transition-colors">
              <summary class="cursor-pointer font-semibold text-primary-600 list-none flex justify-between items-center">
                <span class="pr-8">{item.question}</span>
                <svg
                  class="w-5 h-5 text-[#3F8D65] group-open:rotate-180 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  ></path>
                </svg>
              </summary>
              <p class="mt-4 text-neutral-600 leading-relaxed">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
)}


    <!-- 📚 Deep Dive (uniqueDeepDive) - Section technique avancée -->
    {cityNote?.uniqueDeepDive && (
      <section class="bg-white section-padding border-y border-neutral-100">
        <div class="container-responsive">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-600 mb-6">
              Particularités à {city.name} – ce que nous prenons en compte
            </h2>
            <div
              class="prose prose-lg prose-slate max-w-none text-neutral-600 leading-relaxed"
            >
              <div set:html={cityNote.uniqueDeepDive} />
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 🧾 CTA final (téléphone + formulaire) -->
    <section
      id="contact-form"
      class="bg-gradient-to-br from-[#3F8D65] to-[#48a674] section-padding"
    >
      <div class="container-responsive">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
              Prêt à {serviceVerbs[service.key] || 'traiter'} vos surfaces à {city.name} ?
            </h2>
            <p
              class="text-white/90 text-lg leading-relaxed max-w-2xl mx-auto"
            >
              Obtenez un devis gratuit et sans engagement. Un expert Klinova vous répond
              sous 2 heures.
            </p>
          </div>

          <div class="bg-white rounded-2xl shadow-xl p-8">
            <form
              id="form-city"
              method="post"
              action="/api/contact"
              class="space-y-6"
            >
              <input
                type="hidden"
                name="source"
                value={`citypage-${service.key}-${citySlug}`}
              />
              <input type="hidden" name="service" value={service.name} />
              <input type="hidden" name="city" value={city.name} />

              <div class="grid gap-6 md:grid-cols-2">
                <div>
                  <label
                    for="form-name"
                    class="block text-sm font-medium text-primary-600 mb-2"
                  >
                    Nom complet <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="form-name"
                    name="name"
                    type="text"
                    required
                    placeholder="Jean Dupont"
                    class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-primary-600 focus:outline-none focus:ring-2 focus:ring-[#3F8D65] focus:border-transparent transition"
                  />
                </div>

                <div>
                  <label
                    for="form-phone"
                    class="block text-sm font-medium text-primary-600 mb-2"
                  >
                    Téléphone <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="form-phone"
                    name="phone"
                    type="tel"
                    required
                    placeholder="06 12 34 56 78"
                    class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-primary-600 focus:outline-none focus:ring-2 focus:ring-[#3F8D65] focus:border-transparent transition"
                  />
                </div>

                <div class="md:col-span-2">
                  <label
                    for="form-email"
                    class="block text-sm font-medium text-primary-600 mb-2"
                  >
                    Email
                  </label>
                  <input
                    id="form-email"
                    name="email"
                    type="email"
                    placeholder="jean.dupont@example.com"
                    class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-primary-600 focus:outline-none focus:ring-2 focus:ring-[#3F8D65] focus:border-transparent transition"
                  />
                </div>

                <div class="md:col-span-2">
                  <label
                    for="form-message"
                    class="block text-sm font-medium text-primary-600 mb-2"
                  >
                    Votre message
                  </label>
                  <textarea
                    id="form-message"
                    name="message"
                    rows="5"
                    placeholder={`Décrivez votre besoin : surface à traiter, fréquence souhaitée, contraintes particulières pour votre intervention à ${city.name}...`}
                    class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-primary-600 focus:outline-none focus:ring-2 focus:ring-[#3F8D65] focus:border-transparent transition resize-none"
                  ></textarea>
                </div>

                <div class="md:col-span-2">
                  <button
                    type="submit"
                    class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-[#3F8D65] text-white font-semibold rounded-xl shadow-lg hover:bg-[#387B58] transition-all duration-300"
                  >
                    Envoyer ma demande
                    <svg
                      class="ml-2 w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      ></path>
                    </svg>
                  </button>
                </div>

                <div class="md:col-span-2 text-sm text-neutral-600">
                  <p>
                    En soumettant ce formulaire, vous acceptez d'être contacté par Klinova
                    concernant votre demande.
                    <a
                      href="/politique-de-confidentialite"
                      class="text-[#3F8D65] hover:underline ml-1"
                    >
                      Politique de confidentialité
                    </a>
                  </p>
                </div>
              </div>
            </form>

            <div class="mt-8 text-center border-t border-neutral-100 pt-8">
              <p class="text-sm text-neutral-600 mb-4">
                Vous préférez nous appeler directement ?
              </p>
              <a
                href="tel:+33676738661"
                class="inline-flex items-center gap-2 text-[#3F8D65] font-bold text-xl hover:text-[#387B58] transition-colors"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
                06 76 73 86 61
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</LayoutWithCTA>
