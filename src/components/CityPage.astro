---
// src/components/CityPage.astro - Version Premium Conversion/SEO Optimisée

import LayoutWithCTA from '~/layouts/LayoutWithCTA.astro';
import type { City, CityServiceLocal, ServiceConfig, Department } from '~/types/geo';

import CrossServiceMoquettesNote from "~/components/Sections/CrossServiceMoquettesNote.astro";


import { PHONE_E164, PHONE_DISPLAY } from '~/lib/phone';

import ButtonSubmit from './UI/ButtonSubmit.astro';
import Button from './UI/Button.astro';

import BookingTextiles from '~/components/BookingTextiles';
import ResultatsTextilesCity from '~/components/Sections/ResultatsTextilesCity.astro';
import CityTextilesSituations from '~/components/Sections/CityTextilesSituations.astro';
import CityMoquettesDetail from '~/components/Sections/CityMoquettesDetail.astro';
import CityParkingsExpertise from '~/components/Sections/CityParkingsExpertise.astro';
import CityBalconsFientesLocal from '~/components/Sections/CityBalconsFientesDetail.astro';
import CityBalconsComplete from './Sections/CityBalconsComplete.astro';
import CityBalconsPigeons from '~/components/Sections/CityBalconsPigeons.astro';

import PricingTextiles from '~/components/Sections/PricingTextiles.astro';
import PricingMoquettes from '~/components/Sections/PricingMoquettes.astro';
import PricingParkingsShort from '~/components/Sections/PricingParkingsShort.astro';

import AvailabilityBadge from '~/components/AvailabilityBadge.astro';
import CityWhyUs from '~/components/Sections/CityWhyUs.astro';




// 🗂️ Data imports
import citiesIndex from '~/data/cities';

// 🖼️ Assets Hero fallbacks
import heroParkingsDesktop from '~/assets/images/nettoyage-parking-professionnel-paris.webp';
import heroParkingsMobile  from '~/assets/images/nettoyage-parking-professionnel-paris.webp';
import heroBalconsDesktop  from '~/assets/images/Klinova_nettoyage_balcon_soigne.webp';
import heroBalconsMobile   from '~/assets/images/Klinova_nettoyage_balcon_soigne.webp';
import heroMoquettesDesktop from '~/assets/images/nettoyage-moquettes-avant-apres.jpg';
import heroMoquettesMobile from '~/assets/images/nettoyage-moquette-avant-apres-mobile.webp';
import heroCanapesDesktop from '~/assets/images/nettoyage-canapes-tapis-matelas-desktop.jpg';
import heroCanapesMobile from '~/assets/images/nettoyage-canapes-tapis-matelas-klinova.jpeg';


import { buildPricingOffers } from "~/lib/schema/pricing";




interface Props {
  city: City;
  service: ServiceConfig;
  department: Department;
  showReviewsWidget?: boolean;
}

const { city, service, department, showReviewsWidget = false, } = Astro.props as Props;


import { aVille, deVille } from "~/lib/geo-klinova";
const cityAt = aVille(city.name);   // ex: "au Raincy", "aux Lilas", "à l'Haÿ-les-Roses", "à Paris"
const cityFrom = deVille(city.name); // ex: "du Raincy", "des Lilas", "de l'Haÿ-les-Roses", "de Paris"




const serviceContextLabels: Record<string, string> = {
  moquettes: 'vos moquettes',
  'canapes-tapis': 'vos canapés, tapis et matelas',
  parkings: 'vos parkings et garages',
  balcons: 'vos balcons',
  'balcons-fientes': 'vos balcons souillés par les pigeons',
};
const serviceContext =
  serviceContextLabels[service.key] ?? 'les surfaces concernées';

// 🔧 Config des services pour la section "Autres services à {ville}"
const allServicesForCards = [
  {
    key: 'moquettes',
    name: 'Nettoyage de moquettes',
    shortDescription:
      'Entretien et détachage de moquettes en copropriété, bureaux et parties communes.',
  },
  {
    key: 'parkings',
    name: 'Nettoyage de parkings',
    shortDescription:
      'Nettoyage en profondeur des parkings souterrains, rampes et zones de circulation.',
  },
  {
    key: 'balcons',
    name: 'Nettoyage de balcons et terrasses',
    shortDescription:
      'Remise en état des balcons, terrasses et loggias en respectant les revêtements.',
  },
  {
    key: 'balcons-fientes',
    name: 'Balcons – fientes de pigeons (désinfection)',
    shortDescription:
      'Décontamination et désinfection de balcons souillés par les fientes de pigeons.',
  },
  {
    key: 'canapes-tapis',
    name: 'Nettoyage de canapés, tapis et matelas',
    shortDescription:
      'Nettoyage professionnel des textiles d’ameublement directement au domicile.',
  },
];





// Utils
const slugify = (v: string) =>
  v
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');

type ImgLike = string | { src: string };
const toSrc = (x?: ImgLike) => (typeof x === 'string' ? x : x?.src || '');

// 🔑 Clés de service et slugs locaux associés
type ServiceKey = 'moquettes' | 'parkings' | 'balcons' | 'balcons-fientes' | 'canapes-tapis';

const serviceSlugByKey: Record<ServiceKey, string> = {
  moquettes: 'nettoyage-moquettes',
  parkings: 'nettoyage-parkings',
  balcons: 'nettoyage-balcons',
  'balcons-fientes': 'nettoyage-balcons-fientes-pigeons',
  'canapes-tapis': 'nettoyage-canapes-tapis-matelas',
};


const showAvanceImmed = service.key !== "parkings";

// Slug du service courant pour cette page locale
const currentServiceSlug = serviceSlugByKey[service.key as ServiceKey];
if (!currentServiceSlug) throw new Error(`Unknown service key: ${service.key}`);


// Slugs & canonical
const citySlug = city.slug ?? slugify(city.name);
const departmentSlug = department.slug ?? slugify(department.name);

// Canonical = toujours l'URL réelle de la page
const canonical = Astro.url.pathname || `/zones-d-intervention/${departmentSlug}/${citySlug}/${currentServiceSlug}`;


// 🔀 Autres services Klinova pour cette ville (maillage local cross-service)
const otherServicesForCity = allServicesForCards
  .filter((svc) => svc.key !== service.key) // on enlève le service de la page
  .map((svc) => {
    const localSlug = serviceSlugByKey[svc.key as ServiceKey];
    const href = `/zones-d-intervention/${departmentSlug}/${citySlug}/${localSlug}`;

    return {
      ...svc,
      href,
    };
  });
  // 👉 si tu veux limiter à 3 cartes max :
  // .slice(0, 3);



// Service note spécifique ville
const cityNote: CityServiceLocal | undefined =
  Array.isArray(city.services)
    ? city.services.find((s: CityServiceLocal) => s.serviceKey === service.key)
    : undefined;

// 🔎 Défis spécifiques pour le service courant (au niveau ville + service)
const specificChallenges =
  cityNote?.specificChallenges && cityNote.specificChallenges.length > 0
    ? cityNote.specificChallenges
    : [];



    // Texte court pour le hero
let heroDescription = cityNote?.heroDescription;

// 1️⃣ Si aucune heroDescription n’est fournie : fallback = customDescription (ville)
if (!heroDescription && city.customDescription) {
  const text = city.customDescription
    .replace(/\s+/g, ' ')
    .trim();

  // On sécurise : si jamais pas de point, on en ajoute un
  // si > 30 mots, on coupe proprement au premier point
  const wordCount = text.split(' ').length;

  if (wordCount <= 30) {
    heroDescription = text.endsWith('.') ? text : text + '.';
  } else {
    heroDescription = text.split('. ')[0] + '.';
  }
}




const tiers = Array.isArray(service.pricingTiers) ? service.pricingTiers : [];
const firstFromTier = tiers.find((t) => t.priceType === "from");
const firstRangeTier = tiers.find((t) => t.priceType === "range");







const ogImageAlt = `Klinova — Nettoyage professionnel de ${serviceContext} ${cityAt}`;

// Résolution des villes proches à partir de city.nearbyCities
const nearbyCitiesResolved =
  city.nearbyCities && city.nearbyCities.length > 0
    ? (city.nearbyCities
        .map((slug) => {
          const found = (citiesIndex as City[]).find((c) => (c.slug ?? slugify(c.name)) === slug);
          if (!found) return null;
          const s = found.slug ?? slugify(found.name);
          const deptSlug = found.department?.slug ?? departmentSlug;
          return { name: found.name, slug: s, deptSlug };
        })
        .filter((c) => c !== null) as { name: string; slug: string; deptSlug: string }[])
    : [];

// Autres villes pour maillage horizontal (hors ville actuelle et hors nearbyCities)
const excludeSlugs = new Set<string>([
  citySlug,
  ...(city.nearbyCities ?? []),
]);


// Images hero par service





const heroFallback: Record<ServiceKey, { desktop: ImgLike; mobile: ImgLike }> = {
  moquettes: {
    desktop: heroMoquettesDesktop,
    mobile: heroMoquettesMobile,
  },
  parkings: { desktop: heroParkingsDesktop, mobile: heroParkingsMobile },
  balcons: { desktop: heroBalconsDesktop, mobile: heroBalconsMobile },
  'balcons-fientes': { desktop: heroBalconsDesktop, mobile: heroBalconsMobile },
  'canapes-tapis': {
    desktop: heroCanapesDesktop,
    mobile: heroCanapesMobile,
  },
};


const heroDesktop = toSrc(
  service.images?.heroDesktop ??
  city.images?.heroDesktop ??
  heroFallback[service.key as ServiceKey]?.desktop ??
  '/images/default-hero.webp',
);

const heroMobile = toSrc(
  service.images?.heroMobile ??
  city.images?.heroMobile ??
  heroFallback[service.key as ServiceKey]?.mobile ??
  '/images/default-hero-mobile.webp',
);

// URLs service parent
const serviceUrl =
  service.urls?.parent ??
  ((
    {
      moquettes: '/nettoyage-moquettes',
      parkings: '/nettoyage-parkings',
      balcons: '/nettoyage-balcons',
      'balcons-fientes': '/nettoyage-balcons-fientes-pigeons',
      'canapes-tapis': '/nettoyage-canapes-tapis-matelas',
    } as Record<string, string>
  )[service.key] ?? '/');



// ============================================================
// LOGIQUE DE ROTATION DES QUARTIERS (subset déterministe)
// ============================================================

// 1. Fonction de "hash" simple pour avoir un seed stable par service
const getSeedFromString = (str: string) => {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  return Math.abs(hash);
};

// 2. Préparation de la liste des quartiers
const allDistricts = Array.isArray(city.districts) ? city.districts : [];
const DISPLAY_COUNT = 6; // nb max de quartiers à afficher sur la page service

let selectedDistricts = allDistricts;

if (allDistricts.length > DISPLAY_COUNT && service) {
  // On utilise une info du service comme "graine" pour que :
  // - le subset soit stable pour ce service
  // - différent d'un service à l'autre
  const seedSource =
    (service.urls && service.urls.parent) ||
    (service.key as string) ||
    service.name ||
    '';

  const seed = getSeedFromString(seedSource);

  // Liste circulaire pour pouvoir couper n'importe où
  const circularList = [...allDistricts, ...allDistricts];

  // Index de départ déterministe
  const startIndex = seed % allDistricts.length;

  // On prend le "morceau" voulu
  selectedDistricts = circularList.slice(startIndex, startIndex + DISPLAY_COUNT);
}

///Fin de LOGIQUE DE ROTATION DES QUARTIERS (subset déterministe)


// SEO optimisé
const pageTitle = `${service.name} ${cityAt} – Klinova`;

const departmentName = department.name ?? city.department?.name ?? 'Île-de-France';
const departmentCode = department.code ?? city.department?.code ?? 'IDF';

const description =
  service.defaultDescription
    ? `${service.defaultDescription} Intervention ${cityAt} (${departmentCode}) et dans les communes voisines de ${departmentName}.`
    : `${service.name} ${cityAt} (${departmentCode}) pour copropriétés, résidences et gestionnaires.`;




// Contenu dynamique
const ctaLabel =
  cityNote?.ctaOverride ||   // 1) CTA spécifique ville + service (city.services[].ctaOverride)
  service.ctaOverride ||     // 2) CTA global du service (canapes-tapis.config)
  city.ctaOverride ||        // 3) CTA global de la ville (city.ctaOverride)
  'Contactez-nous';          // 4) Fallback générique

const serviceLabel = `${service.name} – ${city.name}`;

// Verbes par service pour CTA naturel
const serviceVerbs: Record<string, string> = {
  moquettes: 'nettoyer',
  parkings: 'entretenir',
  balcons: 'rénover',
  'balcons-fientes': 'désinfecter',
  'canapes-tapis': 'nettoyer',
};

// Benefits (non affichés pour l’instant mais dispo si besoin)
const serviceBenefits = service.benefits ?? [
  'Intervention rapide et planifiée',
  'Matériel professionnel adapté',
  'Respect des normes environnementales',
  'Devis transparent et détaillé',
];

// Process avec fallback
const defaultProcess = [
  {
    step: 'Diagnostic',
    description: 'Évaluation des surfaces et identification des besoins spécifiques.',
  },
  {
    step: 'Intervention',
    description: 'Nettoyage professionnel avec équipement adapté.',
  },
  {
    step: 'Contrôle qualité',
    description: 'Vérification du résultat et compte-rendu détaillé.',
  },
];
const serviceProcess = service.process ?? defaultProcess;




// --- DANS CityPage.astro ---

const MAX_FAQ_TOTAL = 6;

// ✅ FAQ unique ville + service (objectif anti-duplicate)
const combinedFaq = (cityNote?.faqAdditions ?? []).slice(0, MAX_FAQ_TOTAL);




// JSON-LD optimisé

const baseUrl = import.meta.env.SITE ?? 'https://klinova.fr';
const pageUrl = `${baseUrl}${canonical}`;


const pricingOffers = buildPricingOffers({
  pricingTiers: service.pricingTiers,
  legacyPricing: service.pricing,
  pageUrl,
  fallbackOfferName: `${service.name} ${cityAt}`,
  fallbackOfferDescription: description,
});


const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage-city-service`,
  url: pageUrl,
  name: pageTitle,
  description,
  isPartOf: { '@id': `${baseUrl}#website` },
  inLanguage: 'fr-FR',
};

const serviceId = `${pageUrl}#service`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: "Zones d'intervention",
      item: `${baseUrl}/zones-d-intervention`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: `${department.name} (${department.code})`,
      item: `${baseUrl}/zones-d-intervention/${departmentSlug}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: city.name,
      item: `${baseUrl}/zones-d-intervention/${departmentSlug}/${citySlug}`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: service.name,
      item: pageUrl,
    },
  ],
};



const faqEntities = combinedFaq.map((item) => ({
  "@type": "Question",
  name: item.question,
  acceptedAnswer: { "@type": "Answer", text: item.answer },
}));




// ============================================================
// Construction Service JSON-LD (OfferCatalog alimenté)
// ============================================================

const serviceJsonLd: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": serviceId,
  serviceType: service.name,
  name: `${service.name} ${cityAt}`,
  description,

  provider: {
    "@id": `${baseUrl}#localbusiness`,
  },

  areaServed: {
    "@type": "City",
    name: city.name,
    postalCode: city.postalCodes?.[0],
    addressCountry: "FR",
    ...(city.wikipediaUrl && { sameAs: city.wikipediaUrl }),
  },

  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `Tarifs ${service.name} ${cityAt}`,
    itemListElement: pricingOffers,
  },
};







// HowTo basé sur le process (optionnel)
const howToJsonLd =
  serviceProcess && serviceProcess.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'HowTo',
        name: `${service.name} ${cityAt} – protocole d'intervention`,
        description,
        step: serviceProcess.map((step, index) => ({
          '@type': 'HowToStep',
          position: index + 1,
          name: step.step,
          itemListElement: [
            {
              '@type': 'HowToDirection',
              text: step.description,
            },
          ],
        })),
      }
    : null;

const jsonLd: any[] = [
  webPageJsonLd,
  serviceJsonLd,
  breadcrumbJsonLd,
  ...(faqEntities.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faqEntities,
        },
      ]
    : []),
  ...(howToJsonLd ? [howToJsonLd] : []),
];



const isBalconService =
  service?.key === "balcons" || service?.key === "balcons-fientes";

// Prix “À partir de …” : on prend le 1er tier priceType="from"

const fromPrice = firstFromTier && "from" in firstFromTier ? firstFromTier.from : undefined;


const caseStudy = cityNote?.caseStudy;
const photos = cityNote?.photos ?? [];

---

<LayoutWithCTA
  popupContext={{
    title: 'Demander à être rappelé',
    subtitle: 'Un conseiller de Klinova vous contacte sous 24h pour discuter de votre projet.',
    serviceKey: service.key,
    serviceLabel,
    trackingSource: `citypage-${service.key}-${citySlug}`,
     creditImpotEnabled: true
  }}

  stickyEnabled={true}
  stickyShowAfter="scroll"
  hideSelector="[data-hide-floating-cta]"
  activateSelector="[data-activate-floating-cta]"
  activateDelayMs={800}
  stickyMobileOnly={true}

  pathname={Astro.url.pathname}
  
  title={pageTitle}
  description={description}
  canonical={canonical}
  ogImage="/images/og/og-klinova-home.png"
  ogImageAlt={ogImageAlt}
  appendBrandToTitle={false}
  jsonLd={jsonLd}
>



  <!-- Preload hero images -->
  <Fragment slot="head">
  {heroDesktop && (
    <link
      rel="preload"
      as="image"
      href={heroDesktop}
      fetchpriority="high"
      media="(min-width:768px)"
    />
  )}
  {heroMobile && (
    <link
      rel="preload"
      as="image"
      href={heroMobile}
      fetchpriority="high"
      media="(max-width:767px)"
    />
  )}
</Fragment>


  <main class="min-h-[70vh] bg-neutral-50">
   <!-- 🧭 Fil d'Ariane -->
<nav aria-label="Fil d'Ariane" class="bg-white border-b border-neutral-200">
  <div class="container-responsive py-3">
    <ol class="flex flex-wrap gap-2 text-sm text-neutral-600">
      <li>
        <a href="/" class="hover:text-primary-600 transition-colors">Accueil</a>
      </li>
      <li aria-hidden="true" class="text-neutral-400">/</li>

      <li>
        <a href="/zones-d-intervention" class="hover:text-primary-600 transition-colors">
          Zones d'intervention
        </a>
      </li>
      <li aria-hidden="true" class="text-neutral-400">/</li>

      <!--Nouveau niveau : département -->
      <li>
        <a
          href={`/zones-d-intervention/${departmentSlug}`}
          class="hover:text-primary-600 transition-colors"
        >
          {department.name}
        </a>
      </li>
      <li aria-hidden="true" class="text-neutral-400">/</li>

      <!--Niveau ville -->
      <li>
        <a
          href={`/zones-d-intervention/${departmentSlug}/${citySlug}`}
          class="hover:text-primary-600 transition-colors"
        >
          {city.name}
        </a>
      </li>
      <li aria-hidden="true" class="text-neutral-400">/</li>

      <!--Page actuelle = service -->
      <li aria-current="page" class="font-medium text-primary-600">
        {service.name}
      </li>
    </ol>
  </div>
</nav>


    <!-- 1️⃣ Hero local (image + H1 + CTA) -->
<section
  class="relative isolate h-[80vh] md:h-auto md:min-h-[72vh] lg:min-h-[78vh] overflow-hidden"
  data-hide-floating-cta
  data-hide-header-cta
>

  <!--BG -->
  <div class="absolute inset-0 z-0">
    <picture class="absolute inset-0 block">
      <source media="(min-width:768px)" srcset={heroDesktop} />
      <img
        src={heroMobile}
        alt={`${service.name} professionnel ${cityAt} par Klinova`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </picture>
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/25 to-transparent z-[1]"
      aria-hidden="true"
    ></div>
  </div>

  <!--✅ Contenu + CTA -->
  <div class="relative z-10 h-full">
    <!--TEXTE (en haut) -->
    <div class="container-responsive h-full pt-8 sm:pt-10 lg:pt-12 pb-24 sm:pb-10 lg:pb-12">

      <div class="text-center max-w-5xl mx-auto">

        {isBalconService ? (
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 mb-4 animate-fade-in-up">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
            </span>
            <span class="text-sm font-semibold text-blue-900 tracking-wide">
              {fromPrice ? `À partir de ${fromPrice} € TTC` : "Sur devis"}
            </span>
          </div>
        ) : (
          <div class="inline-flex items-center px-4 py-2 bg-white/80 backdrop-blur-sm rounded-full text-sm font-medium text-[#3F8D65] border border-[#3F8D65]/20 mb-4 md:mb-3 lg:mb-2 hero-badge">
            <span class="w-2 h-2 bg-[#3F8D65] rounded-full mr-2 animate-pulse"></span>
            {department.name}
          </div>
        )}

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white drop-shadow-lg leading-tight mb-4 md:-mt-1 lg:-mt-2">
  <span class={service.key === "canapes-tapis" ? "inline leading-none" : "inline md:block leading-none"}>
    {service.name}
  </span>{" "}
  <span class={service.key === "canapes-tapis" ? "inline leading-none" : "inline md:block leading-none"}>
    {cityAt}
  </span>
</h1>


        {heroDescription && (
          <div class="mb-2 md:mb-4">
            <p class="text-lg md:text-2xl text-white/95 mb-4 md:mb-4 max-w-3xl mx-auto leading-relaxed">
              {heroDescription}
            </p>

            {showAvanceImmed && (
              <p class="text-sm md:text-base text-orange-200 mb-4 font-medium
                        opacity-100 motion-safe:animate-fade-in-up
                        [animation-delay:480ms]
                        [animation-timing-function:cubic-bezier(0.25,0.46,0.45,0.94)]">
                <span class="inline-flex items-center group">
                  <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform duration-200"
                       fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clip-rule="evenodd"></path>
                  </svg>
                  Particuliers : payez seulement 50% aujourd'hui
                  <br class="sm:hidden" /> avec l'avance immédiate du crédit d'impôt SAP
                </span>
              </p>
            )}
          </div>
        )}

        <!--CTA — DESKTOP (dans le flow) -->
        <div class="hidden sm:block mt-8">
          <div class="flex flex-row gap-4 justify-center items-center">
            <Button
              href="#formulaire"
              label={ctaLabel}
              variant="primary"
              size="lg"
              tracking={{
                action: "lead",
