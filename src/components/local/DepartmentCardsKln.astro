---
// src/components/local/DepartmentCardsKln.astro

import { DEPARTMENTS } from "~/data/departments";
import { featuredCities } from "~/data/highlightedCities";

type CityLink = {
  name: string;
  slug: string;
  deptSlug: string;
};

type Props = {
  variant?: "default" | "white";
  showDescription?: boolean;
  onlyCovered?: boolean;
  topCitiesPerDept?: number;
  title?: string;
  description?: string;
  excludeDeptSlug?: string | null;
  serviceSlug?: string | null;
  autoDescription?: boolean;
  deptSeoTextOverride?: Partial<Record<string, string>>;
  cities?: CityLink[] | null; // ✅
};

const {
  variant = "default",
  showDescription = true,
  onlyCovered = false,
  topCitiesPerDept = 3,
  title = "Klinova intervient dans toute l'Île-de-France",
  description = "",
  excludeDeptSlug = null,
  serviceSlug = null,
  deptSeoTextOverride = {},
  cities = null,
} = Astro.props as Props;

const featured: CityLink[] = Array.isArray(cities) ? cities : featuredCities;

// SEO mini-text
const DEPT_SEO_TEXT: Record<string, string> = {
  paris: "Interventions en immeubles et résidences, contraintes d’accès et d’horaires.",
  "seine-et-marne": "Pavillons et résidences récentes : surfaces variées, accès/stationnement.",
  yvelines: "Résidentiel et copropriétés : protocole régulier et finitions propres.",
  essonne: "Habitat mixte : organisation par secteurs, interventions planifiées.",
  "hauts-de-seine": "Résidences denses et sites tertiaires : exigence d’image et propreté.",
  "seine-saint-denis": "Forte fréquentation : rigueur, traçabilité et résultats visibles.",
  "val-de-marne": "Copropriétés, pavillons : nettoyage adapté aux matériaux et usages.",
  "val-d-oise": "Sites étendus : tournées optimisées, interventions coordonnées.",
};

const SERVICE_DESCRIPTION: Record<string, string> = {
  "nettoyage-moquettes":
    "Nettoyage de moquettes en Île-de-France : extraction, détachage et séchage maîtrisé, avec une organisation par secteurs pour limiter les nuisances.",
  "nettoyage-parkings":
    "Nettoyage de parkings en Île-de-France : autolaveuse, décrassage en profondeur et finitions propres, avec interventions planifiées par secteurs.",
  "nettoyage-balcons":
    "Nettoyage de balcons en Île-de-France : remise au propre des sols et surfaces, rinçage contrôlé et finitions nettes, selon l’accès et les contraintes d’immeuble.",
  "nettoyage-balcons-fientes-pigeons":
    "Nettoyage de balcons souillés par fientes en Île-de-France : protocole d’hygiène renforcée, désinfection et remise au propre, avec protections adaptées.",
  "nettoyage-canapes-tapis-matelas":
    "Nettoyage de canapés, tapis et matelas en Île-de-France : injection-extraction ou méthodes adaptées, détachage ciblé et séchage rapide.",
};

const resolvedDescription =
  (description && description.trim().length > 0)
    ? description
    : (serviceSlug ? (SERVICE_DESCRIPTION[serviceSlug] ?? "") : "Interventions organisées par secteurs en Île-de-France, avec une méthode constante et des finitions propres.");

    
  function getDeptText(deptSlug: string) {
  return (
    deptSeoTextOverride?.[deptSlug] ??
    DEPT_SEO_TEXT[deptSlug] ??
    "Interventions planifiées, méthode constante et finitions propres."
  );
}


const sectionBg = variant === "white" ? "bg-white" : "bg-[#FCFCFC]";



function getTopFeaturedCitiesForDept(deptSlug: string, limit: number) {
  if (limit <= 0) return [];
  return featured.filter((c) => c.deptSlug === deptSlug).slice(0, limit);
}

function isDeptCovered(deptSlug: string) {
  return featured.some((c) => c.deptSlug === deptSlug);
}

const departmentsToRender = DEPARTMENTS
  .filter((d) => (excludeDeptSlug ? d.slug !== excludeDeptSlug : true))
  .filter((d) => (onlyCovered ? isDeptCovered(d.slug) : true));

---

<section class={`py-16 ${sectionBg} border-t border-[#E5E7EB]`}>
  <div class="container-responsive">
    <div class="text-center max-w-4xl mx-auto mb-12">
      <p class="text-xs font-bold text-[#3F8D65] uppercase tracking-widest mb-3">
        Couverture régionale
      </p>

      <h2 class="text-3xl md:text-4xl font-extrabold text-[#1E2939] mb-6 tracking-tight">
        {title}
      </h2>

     {showDescription && resolvedDescription && (
  <p class="text-lg text-[#475569] leading-relaxed max-w-2xl mx-auto">
    {resolvedDescription}
  </p>
)}

    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {departmentsToRender.map((dept) => {
        const topCities = getTopFeaturedCitiesForDept(dept.slug, topCitiesPerDept);
        const hasCities = topCities.length > 0;

        return (
          <article class="flex flex-col h-full bg-white border border-[#E5E7EB] rounded-2xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group">
            <!--Header -->
            <a href={`/zones-d-intervention/${dept.slug}`} class="block p-6 pb-2 relative overflow-hidden">
              <span class="absolute -top-4 -right-4 text-8xl font-black text-[#F1F5F9] group-hover:text-[#DFF1E8] transition-colors duration-500 select-none z-0">
                {dept.code}
              </span>

              <div class="relative z-10">
                <div class="flex items-center gap-3 mb-2">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#DFF1E8] text-[#387B58] font-bold text-sm border border-[#C0E2D0]">
                    {dept.code}
                  </span>
                  <h3 class="text-xl font-bold text-[#1E2939] group-hover:text-[#387B58] transition-colors">
                    {dept.name}
                  </h3>
                </div>

             <p class="text-sm text-[#475569] leading-snug min-h-[3rem]">
  {getDeptText(dept.slug)}
</p>


              </div>
            </a>

            <!--Corps : top villes -->
            <div class="px-6 pb-6 mt-auto relative z-10">
              {hasCities ? (
                <>
                  <div class="w-full h-px bg-[#E5E7EB] my-4"></div>
                  <p class="text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-3">
                    Villes (pages locales)
                  </p>

                  <ul class="space-y-2 mb-5">
                    {topCities.map((city) => (
                      <li>
                        <a
                         href={
  serviceSlug
    ? `/zones-d-intervention/${dept.slug}/${city.slug}/${serviceSlug}`
    : `/zones-d-intervention/${dept.slug}/${city.slug}`
}

                          class="flex items-center text-sm font-medium text-[#475569] hover:text-[#387B58] hover:pl-1 transition-all duration-200 group/link"
                        >
                          <svg class="w-3 h-3 text-[#C0E2D0] mr-2 group-hover/link:text-[#3F8D65]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                          {city.name}
                        </a>
                      </li>
                    ))}
                  </ul>

                  <a
                    href={`/zones-d-intervention/${dept.slug}`}
                    class="inline-flex items-center text-xs font-bold text-[#3F8D65] hover:text-[#387B58] uppercase tracking-wide"
                  >
                    Voir tout le {dept.code}
                    <svg class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                </>
              ) : (
                <div class="mt-4 pt-4 border-t border-[#E5E7EB]">
                  <a
                    href={`/zones-d-intervention/${dept.slug}`}
                    class="inline-flex items-center justify-center w-full px-4 py-2 text-sm font-medium text-[#475569] bg-[#FCFCFC] rounded-lg border border-[#E5E7EB] hover:bg-white hover:border-[#3F8D65]/40 hover:text-[#387B58] transition-all"
                  >
                    Voir la zone
                  </a>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>

 <div class="mt-12 text-center">
      <a 
        href="/zones-d-intervention" 
        class="inline-flex items-center gap-2 px-6 py-2 bg-[#DFF1E8] text-[#1E2939] rounded-full text-sm font-semibold border border-[#C0E2D0] hover:bg-[#C0E2D0] hover:shadow-md transition-all duration-300 group"
      >
        <span class="w-2 h-2 rounded-full bg-[#3F8D65] animate-pulse"></span>
        Voir toutes nos zones d'intervention en Île-de-France
        <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
