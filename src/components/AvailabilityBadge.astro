---
import { aVille, deVille } from "~/lib/geo-klinova";

interface Props {
  cityName: string;
  position?: "hero" | "form";
  variant?: "default" | "compact";
}

const { cityName, position = "hero", variant = "default" } = Astro.props as Props;

const cityAt = aVille(cityName);
const cityFrom = deVille(cityName);

// Messages de disponibilité (un message fixe par ville)
const availabilityMessages = [
  `Créneaux disponibles cette semaine ${cityAt}`,
  `Intervention possible sous 72h ${cityAt}`,
  `Disponibilités ouvertes actuellement ${cityAt}`,
  `Rendez-vous possibles cette semaine ${cityAt}`
];

const messageIndex = cityName.length % availabilityMessages.length;
const message = availabilityMessages[messageIndex];

const baseClasses =
  'inline-flex items-center gap-2 text-sm font-medium rounded-full';

// Version responsive : compact sur mobile, normal sur desktop
const variantClasses = {
  default: {
    hero:
      'text-[#166534] bg-[#DCFCE7] border border-[#22C55E]/30 px-3 py-1.5 md:px-4 md:py-2 backdrop-blur-sm',
    form:
      'text-[#166534] bg-[#DCFCE7] border border-[#22C55E]/30 px-2 py-1 md:px-3 md:py-1.5'
  },
  compact: {
    hero: 'text-[#166534] bg-[#DCFCE7] px-3 py-1',
    form: 'text-[#166534] bg-[#DCFCE7] px-2 py-1'
  }
} as const;

const finalClasses = `${baseClasses} ${variantClasses[variant][position]}`;

// Messages plus courts sur mobile
const mobileMessage = message.replace(cityName, '').replace(/à$/, '').replace(/actuellement/, '').trim();
---

<div class={finalClasses}>
  <!--Dot animé vert -->
  <span class="relative flex h-2 w-2 flex-shrink-0">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#22C55E] opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-[#22C55E]"></span>
  </span>

  <!--Message responsive -->
  <span class="hidden md:inline">{message}</span>
  <span class="md:hidden">{mobileMessage || 'Créneaux disponibles'}</span>

  <!--Icône check -->
  <svg class="w-3 h-3 text-[#166534] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
  </svg>
</div>