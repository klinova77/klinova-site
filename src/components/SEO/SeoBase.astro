---
/**
 * SeoBase.astro — Klinova
 *
 * SEO centralisé :
 * - balises meta (title, description, canonical, OG, Twitter)
 * - JSON-LD en un seul @graph
 *
 * Modèle d'entité retenu :
 *
 *   Organization — KLINOVA
 *   ├── address      → Paris
 *   │                  siège social / adresse légale
 *   ├── location     → Chelles
 *   │                  base opérationnelle, sans adresse de rue
 *   ├── areaServed   → Île-de-France
 *   ├── SIREN / SIRET / TVA
 *   ├── contact      → 06 76 73 86 61
 *   │                  7j/7, 08:00–20:00
 *   │                  français + anglais
 *   └── brand        → Klinova + Stop-Punaises
 *
 * Pourquoi pas LocalBusiness avec l'adresse complète de Chelles ?
 *
 * Le Google Business Profile est actuellement configuré comme :
 * « Aucun établissement physique (livraisons ou services à domicile uniquement) »
 * avec une zone desservie « Île-de-France ».
 *
 * Google Search continue néanmoins d'afficher publiquement l'adresse
 * 9 allée de la Prairie à Chelles. Solocal / PagesJaunes impose également
 * l'affichage d'une adresse complète.
 *
 * Ces affichages externes ne sont donc pas utilisés pour transformer le
 * domicile en établissement physique dans les données structurées.
 *
 * Klinova reste décrite comme basée à Chelles, mais le siège social légal
 * demeure celui de Paris.
 *
 * @id stable : ${site}#organization
 * → utilisable dans les futures pages Service (`provider`).
 */

import { buildSeo } from '~/lib/seo'

export interface Props {
  pathname?: string
  pageType?: string
  appendBrandToTitle?: boolean
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  ogImage?: string
  ogImageAlt?: string
  articleType?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  locale?: string
  jsonLd?: Record<string, any> | Array<Record<string, any>>
  siteName?: string
  hrefLangs?: Record<string, string>
  allowThirdPartyHints?: boolean
}

const {
  pathname,
  pageType,
  appendBrandToTitle = true,
  title = '',
  description = '',
  canonical = '',
  noindex = false,
  ogImage = '/images/og/og-klinova-home.png',
  ogImageAlt = 'Klinova – Propreté & maintenance en Île-de-France',
  articleType = 'website',
  publishedTime,
  modifiedTime,
  locale = 'fr_FR',
  jsonLd,
  siteName = 'Klinova',
  hrefLangs,
  allowThirdPartyHints = false,
} = Astro.props as Props


/* ---------------------------------------------------------------------------
 * Domaine & helpers URL
 * ------------------------------------------------------------------------- */

const site = (
  Astro.site?.toString().replace(/\/+$/, '') || 'https://klinova.fr'
) as string

const toAbs = (url?: string) =>
  !url
    ? site
    : url.startsWith('http')
      ? url
      : `${site}${url.startsWith('/') ? url : `/${url}`}`


/* ---------------------------------------------------------------------------
 * Path effectif
 * ------------------------------------------------------------------------- */

const effectivePath =
  typeof pathname === 'string'
    ? pathname
    : Astro.url?.pathname || '/'

const normalizedPath =
  effectivePath === '/'
    ? '/'
    : effectivePath.replace(/\/+$/, '')


/* ---------------------------------------------------------------------------
 * Auto SEO
 * ------------------------------------------------------------------------- */

const auto = buildSeo({
  pathname: effectivePath,
  pageType,
  title,
  description,
  ogImage,
  noindex,
  canonical,
  appendBrandToTitle,
})

const finalTitle = auto.title
const finalDescription = auto.description
const finalCanonical = auto.canonical
const finalNoindex = auto.noindex
const finalOgImage = auto.ogImage


/* ---------------------------------------------------------------------------
 * Canonical & meta
 * ------------------------------------------------------------------------- */

const canonicalAbs = finalCanonical
  ? toAbs(finalCanonical)
  : canonical
    ? toAbs(canonical)
    : `${site}${effectivePath}`

let canonicalNormalized = canonicalAbs

try {
  const urlObj = new URL(canonicalAbs)

  if (
    urlObj.pathname !== '/' &&
    urlObj.pathname.endsWith('/')
  ) {
    urlObj.pathname = urlObj.pathname.slice(0, -1)
  }

  canonicalNormalized = urlObj.toString()
} catch {
  canonicalNormalized = canonicalAbs
}

const ogImageAbs =
  finalOgImage
    ? toAbs(finalOgImage)
    : ''

const robots =
  finalNoindex
    ? 'noindex, follow'
    : 'index, follow'


/* ===========================================================================
 * DONNÉES D'ENTREPRISE — point unique de vérité
 *
 * Identité juridique :
 * - siège social : Paris
 *
 * Implantation opérationnelle :
 * - Klinova est basée à Chelles
 * - aucun établissement physique n'est déclaré dans Google Business Profile
 * - prestations réalisées chez les clients
 *
 * Références opérationnelles à conserver cohérentes :
 * - téléphone principal : 06 76 73 86 61
 * - horaires : 7j/7, 08:00–20:00
 * - zone desservie : Île-de-France
 *
 * Le 01 85 42 04 78 reste actuellement un numéro secondaire dans le GBP
 * et n'est volontairement pas balisé ici puisqu'il n'est pas présenté
 * comme numéro principal sur le site.
 * ========================================================================= */

const BUSINESS = {
  legalName: 'KLINOVA',
  displayName: 'Klinova',

  telephone: '+33676738661',
  email: 'contact@klinova.fr',

  /*
   * Siège social — société de domiciliation.
   */
  legalAddress: {
    streetAddress: "6 rue d'Armaillé",
    postalCode: '75017',
    addressLocality: 'Paris',
  },

  /*
   * Base opérationnelle.
   *
   * Chelles est indiquée au niveau ville + code postal.
   * On ne publie pas ici l'adresse personnelle complète.
   */
  operationalLocation: {
    postalCode: '77500',
    addressLocality: 'Chelles',
  },

  /*
   * Horaires de disponibilité alignés avec :
   * - le site
   * - Google Business Profile
   *
   * 7 jours sur 7 : 08:00–20:00
   */
  hoursAvailable: [
    {
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: '08:00',
      closes: '20:00',
    },
  ],

  /*
   * Identifiants officiels.
   *
   * SIREN       : 943439810
   * SIRET siège : 94343981000012
   * TVA         : FR92943439810
   *
   * ICD ISO 6523 :
   * - 0002 = SIRENE / SIREN
   * - 0009 = SIRET
   * - 9957 = TVA française
   */
  siren: '943439810',
  siret: '94343981000012',
  vatID: 'FR92943439810',

  /*
   * Sources externes décrivant la même entreprise.
   *
   * TODO :
   * 
   * - ajouter éventuellement la fiche PagesJaunes / Solocal exacte
   *
   * Ne conserver que des URL actives correspondant réellement à KLINOVA.
   */
sameAs: [
  'https://www.google.com/maps/place/KLINOVA+Nettoyage/@48.9042096,2.6021012,17z/data=!3m1!4b1!4m6!3m5!1s0x47e611bcf07989d3:0x8b1947b905612f57!8m2!3d48.9042061!4d2.6046761!16s%2Fg%2F11x6xb_lcz',
  'https://www.pagesjaunes.fr/pros/64422634',
  'https://annuaire-entreprises.data.gouv.fr/entreprise/943439810',
  'https://www.pappers.fr/entreprise/klinova-943439810',
  'https://www.facebook.com/KlinovaNettoyage',
  'https://www.youtube.com/@KlinovaNettoyage',
],
} as const


/* ---------------------------------------------------------------------------
 * JSON-LD — identifiants stables
 * ------------------------------------------------------------------------- */

const orgId = `${site}#organization`
const websiteId = `${site}#website`
const klinovaBrandId = `${site}#brand`
const operationalLocationId = `${site}#operational-location`

const entityImage =
  `${site}/images/og/og-klinova-home.png`


/* ---------------------------------------------------------------------------
 * Pages émettant les données d'entité
 *
 * WebSite :
 * - accueil uniquement
 *
 * Organization :
 * - accueil
 * - à propos
 * - contact
 * ------------------------------------------------------------------------- */

const isHome =
  normalizedPath === '/'

const emitWebsite =
  isHome

const emitOrganization =
  ['/', '/a-propos', '/contact'].includes(normalizedPath)


/* ---------------------------------------------------------------------------
 * Zone d'intervention
 * ------------------------------------------------------------------------- */

const areaServed = [
  'Île-de-France',
  'Paris',
  'Seine-et-Marne',
  'Seine-Saint-Denis',
  'Val-de-Marne',
  'Hauts-de-Seine',
  'Essonne',
  'Yvelines',
  "Val-d'Oise",
].map((name) => ({
  '@type': 'AdministrativeArea',
  name,
}))


/* ---------------------------------------------------------------------------
 * Organization — KLINOVA
 *
 * Une seule entité :
 *
 * - siège social / identité légale → Paris
 * - base opérationnelle → Chelles
 * - pas d'établissement physique déclaré à Chelles
 * - interventions chez les clients
 * - zone de service → Île-de-France
 * ------------------------------------------------------------------------- */

const organizationJsonLd = {
  '@type': 'Organization',
  '@id': orgId,

  name: BUSINESS.displayName,
  legalName: BUSINESS.legalName,

  url: site,

  logo: `${site}/images/logo-klinova.webp`,
  image: entityImage,

  description:
    "Klinova est une entreprise de propreté et de maintenance technique basée à Chelles et intervenant en Île-de-France auprès des copropriétés, entreprises et particuliers : nettoyage de moquettes, parkings, balcons, terrasses, logements et textiles d'ameublement.",

  telephone: BUSINESS.telephone,
  email: BUSINESS.email,


  /* -------------------------------------------------------------------------
   * Siège social / adresse juridique
   * ----------------------------------------------------------------------- */

  address: {
    '@type': 'PostalAddress',

    streetAddress:
      BUSINESS.legalAddress.streetAddress,

    postalCode:
      BUSINESS.legalAddress.postalCode,

    addressLocality:
      BUSINESS.legalAddress.addressLocality,

    addressRegion:
      'Île-de-France',

    addressCountry:
      'FR',
  },


  /* -------------------------------------------------------------------------
   * Base opérationnelle
   *
   * Chelles reste explicitement associée à Klinova sans streetAddress.
   * ----------------------------------------------------------------------- */

  location: {
    '@type': 'Place',
    '@id': operationalLocationId,

    name:
      'Base opérationnelle Klinova à Chelles',

    address: {
      '@type': 'PostalAddress',

      postalCode:
        BUSINESS.operationalLocation.postalCode,

      addressLocality:
        BUSINESS.operationalLocation.addressLocality,

      addressRegion:
        'Île-de-France',

      addressCountry:
        'FR',
    },
  },


  /* -------------------------------------------------------------------------
   * Identifiants officiels
   * ----------------------------------------------------------------------- */

  iso6523Code: [
    `0002:${BUSINESS.siren}`,
    `0009:${BUSINESS.siret}`,
    `9957:${BUSINESS.vatID}`,
  ],

  vatID:
    BUSINESS.vatID,

  identifier: [
    {
      '@type': 'PropertyValue',
      propertyID: 'SIREN',
      value: BUSINESS.siren,
    },
    {
      '@type': 'PropertyValue',
      propertyID: 'SIRET',
      value: BUSINESS.siret,
    },
  ],


  /* -------------------------------------------------------------------------
   * Zone desservie
   * ----------------------------------------------------------------------- */

  areaServed,


  /* -------------------------------------------------------------------------
   * Contact et disponibilité
   *
   * Il s'agit d'horaires de disponibilité / contact et non des horaires
   * d'ouverture d'un établissement physique.
   * ----------------------------------------------------------------------- */

  contactPoint: [
    {
      '@type': 'ContactPoint',

      contactType:
        'customer service',

      telephone:
        BUSINESS.telephone,

      email:
        BUSINESS.email,

      areaServed:
        'Île-de-France',

      availableLanguage: [
        'fr',
        'en',
      ],

      hoursAvailable:
        BUSINESS.hoursAvailable.map((slot) => ({
          '@type':
            'OpeningHoursSpecification',

          dayOfWeek:
            [...slot.dayOfWeek],

          opens:
            slot.opens,

          closes:
            slot.closes,
        })),
    },
  ],


  /* -------------------------------------------------------------------------
   * Sources externes
   * ----------------------------------------------------------------------- */

  sameAs:
    [...BUSINESS.sameAs],


  /* -------------------------------------------------------------------------
   * Marques exploitées
   * ----------------------------------------------------------------------- */

  brand: [
    {
      '@type': 'Brand',

      '@id':
        klinovaBrandId,

      name:
        'Klinova',

      url:
        site,
    },

    {
      '@type': 'Brand',

      '@id':
        'https://stop-punaises.fr#brand',

      name:
        'Stop-Punaises',

      url:
        'https://stop-punaises.fr',

      description:
        'Service spécialisé dans le traitement des punaises de lit.',
    },
  ],
}


/* ---------------------------------------------------------------------------
 * WebSite
 * ------------------------------------------------------------------------- */

const websiteJsonLd = {
  '@type': 'WebSite',
  '@id': websiteId,

  url: site,
  name: siteName,

  publisher: {
    '@id': orgId,
  },

  inLanguage: 'fr-FR',
}


/* ---------------------------------------------------------------------------
 * JSON-LD additionnels fournis par les pages
 *
 * Exemples :
 * - BreadcrumbList
 * - Article
 * - FAQPage
 * - Service
 *
 * On retire uniquement un @context Schema.org déjà porté par le graphe.
 * Un éventuel contexte différent est conservé.
 * ------------------------------------------------------------------------- */

const SCHEMA_CONTEXT =
  /^https?:\/\/schema\.org\/?$/

const rawExtraJsonLd =
  Array.isArray(jsonLd)
    ? jsonLd
    : jsonLd
      ? [jsonLd]
      : []

const extraJsonLd =
  rawExtraJsonLd
    .filter(Boolean)
    .map((node) => {
      const ctx =
        node['@context']

      if (
        typeof ctx === 'string' &&
        SCHEMA_CONTEXT.test(ctx)
      ) {
        const {
          '@context': _dropped,
          ...rest
        } = node

        return rest
      }

      return node
    })


/* ---------------------------------------------------------------------------
 * Construction du graphe JSON-LD
 * ------------------------------------------------------------------------- */

const jsonLdGraphNodes = [
  ...(emitWebsite
    ? [websiteJsonLd]
    : []),

  ...(emitOrganization
    ? [organizationJsonLd]
    : []),

  ...extraJsonLd,
]

const jsonLdGraph =
  jsonLdGraphNodes.length > 0
    ? {
        '@context':
          'https://schema.org',

        '@graph':
          jsonLdGraphNodes,
      }
    : null
---

<title>{finalTitle}</title>

{finalDescription && (
  <meta
    name="description"
    content={finalDescription}
  />
)}

<meta
  name="robots"
  content={robots}
/>

<meta
  name="googlebot"
  content={robots}
/>

{canonicalNormalized && (
  <link
    rel="canonical"
    href={canonicalNormalized}
  />
)}

{hrefLangs &&
  Object.entries(hrefLangs).map(([lang, url]) => (
    <link
      rel="alternate"
      hreflang={lang}
      href={toAbs(url)}
    />
  ))}


{/* Open Graph */}

<meta
  property="og:type"
  content={articleType}
/>

<meta
  property="og:site_name"
  content={siteName}
/>

<meta
  property="og:title"
  content={finalTitle}
/>

{finalDescription && (
  <meta
    property="og:description"
    content={finalDescription}
  />
)}

{canonicalNormalized && (
  <meta
    property="og:url"
    content={canonicalNormalized}
  />
)}

{locale && (
  <meta
    property="og:locale"
    content={locale}
  />
)}

{ogImageAbs && (
  <>
    <meta
      property="og:image"
      content={ogImageAbs}
    />

    <meta
      property="og:image:alt"
      content={ogImageAlt}
    />
  </>
)}


{/* Article */}

{articleType === 'article' && (
  <>
    {publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime}
      />
    )}

    {modifiedTime && (
      <meta
        property="article:modified_time"
        content={modifiedTime}
      />
    )}

    <meta
      property="article:author"
      content={siteName}
    />

    <meta
      property="article:section"
      content="Propreté et hygiène professionnelle"
    />

    <meta
      property="article:tag"
      content="nettoyage professionnel"
    />

    <meta
      property="article:tag"
      content="Île-de-France"
    />
  </>
)}


{/* Twitter */}

<meta
  name="twitter:card"
  content="summary_large_image"
/>

<meta
  name="twitter:title"
  content={finalTitle}
/>

{finalDescription && (
  <meta
    name="twitter:description"
    content={finalDescription}
  />
)}

{ogImageAbs && (
  <>
    <meta
      name="twitter:image"
      content={ogImageAbs}
    />

    <meta
      name="twitter:image:alt"
      content={ogImageAlt}
    />
  </>
)}


{/* JSON-LD */}

{jsonLdGraph && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLdGraph)}
  ></script>
)}


{/* Third-party performance hints */}

{allowThirdPartyHints && (
  <>
    <link
      rel="preconnect"
      href="https://www.google-analytics.com"
      crossorigin
    />

    <link
      rel="preconnect"
      href="https://www.googletagmanager.com"
      crossorigin
    />

    <link
      rel="dns-prefetch"
      href="//www.google-analytics.com"
    />

    <link
      rel="dns-prefetch"
      href="//www.googletagmanager.com"
    />
  </>
)}