---
import { Image } from "astro:assets";
import Button from "~/components/UI/Button.astro";
import type { City } from "~/types/geo";

import { aVille, deVille } from "~/lib/geo-klinova";

import picsAntiPigeons from "~/assets/images/pics-anti-pigeons-inox-balcon.webp";
import filetAntiPigeons from "~/assets/images/filet-anti-pigeons-pour-balcon.jpg";
import gelRepulsif from "~/assets/images/gel-repulsif-anti-pigeon-coupelles.jpg";

interface Props {
  city?: City;
  cityName?: string;
  isLocal?: boolean;
}

const { city, cityName, isLocal: isLocalProp } = Astro.props as Props;

// Flag local/global
const isLocal = !!city && (isLocalProp ?? true);

// Nom brut de ville (si dispo)
const resolvedCityName = city?.name ?? cityName ?? "";

// Label d’affichage (fallback IDF)
const cityLabel = resolvedCityName || "Île-de-France";

// Prépositions (uniquement si on a une ville)
const cityAt = resolvedCityName ? aVille(resolvedCityName) : "";
const cityFrom = resolvedCityName ? deVille(resolvedCityName) : "";
---

<section id="anti-pigeons" class="bg-[#DFF1E8] py-16 lg:py-24">
  <div class="container-responsive">
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-[#1E2939] mb-4">
        Solutions anti-pigeons adaptées à votre balcon à {cityLabel}
      </h2>
      <p class="text-base md:text-lg lg:text-xl text-[#475569] max-w-3xl mx-auto">
        Pics, filets ou gel répulsif : nous recommandons la meilleure solution selon votre configuration et vos contraintes esthétiques.
      </p>
    </div>

    <!-- Grille 2x2 : 3 options + 1 carte diagnostic -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-12">
      
      <!-- Carte: Pics -->
      <article class="group bg-white rounded-2xl border border-[#E5E7EB] overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <figure class="aspect-[4/3] bg-gray-50 overflow-hidden">
          <Image
            src={picsAntiPigeons}
            alt="Pics anti-pigeons en inox posés sur un rebord de balcon"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            formats={['avif','webp','jpeg']}
            quality={86}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </figure>

        <div class="p-6 lg:p-8">
          <div class="flex items-start mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[#EAF6F0] mr-3 flex-shrink-0">
              <svg aria-hidden="true" class="w-6 h-6 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M3 7l5 5 4-8 4 8 5-5v10H3z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939]">Pics anti-pigeons inox</h3>
              <p class="text-sm text-[#475569] mt-1">Rebords étroits, appuis de fenêtre, climatiseurs</p>
            </div>
          </div>
          <ul class="space-y-2 text-[#475569]">
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Discrets et durables (inox qualité marine)
            </li>
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Efficacité immédiate, entretien minimal
            </li>
          </ul>
        </div>
      </article>

      <!-- Carte: Filets -->
      <article class="group bg-white rounded-2xl border border-[#E5E7EB] overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <figure class="aspect-[4/3] bg-gray-50 overflow-hidden">
          <Image
            src={filetAntiPigeons}
            alt="Filet anti-pigeons discret tendu sur une ouverture de balcon"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            formats={['avif','webp','jpeg']}
            quality={86}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </figure>

        <div class="p-6 lg:p-8">
          <div class="flex items-start mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[#EAF6F0] mr-3 flex-shrink-0">
              <svg aria-hidden="true" class="w-6 h-6 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939]">Filets de protection</h3>
              <p class="text-sm text-[#475569] mt-1">Grandes ouvertures, coursives, puits de lumière</p>
            </div>
          </div>
          <ul class="space-y-2 text-[#475569]">
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Protection intégrale, empêche tout accès
            </li>
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Maille et teinte au choix (discrétion)
            </li>
          </ul>
        </div>
      </article>

      <!-- Carte: Gel -->
      <article class="group bg-white rounded-2xl border border-[#E5E7EB] overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <figure class="aspect-[4/3] bg-gray-50 overflow-hidden">
          <Image
            src={gelRepulsif}
            alt="Coupelles de gel répulsif anti-pigeons posées sur un rebord"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            formats={['avif','webp','jpeg']}
            quality={86}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </figure>

        <div class="p-6 lg:p-8">
          <div class="flex items-start mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[#EAF6F0] mr-3 flex-shrink-0">
              <svg aria-hidden="true" class="w-6 h-6 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 2.69l5.66 5.66a8 8 0 11-11.32 0L12 2.69z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939]">Gel répulsif professionnel</h3>
              <p class="text-sm text-[#475569] mt-1">Usage ponctuel ou complément d'autres solutions</p>
            </div>
          </div>
          <ul class="space-y-2 text-[#475569]">
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Application rapide, renouvellement possible
            </li>
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Discret, ne tache pas les supports
            </li>
          </ul>
        </div>
      </article>

      <!-- Carte: Diagnostic & garantie -->
      <article class="bg-[#F8FDF9] rounded-2xl border border-[#C0E2D0] p-6 lg:p-8">
        <div class="flex items-start mb-6">
          <div class="flex items-center justify-center w-16 h-16 rounded-2xl bg-[#EAF6F0] mr-4 flex-shrink-0">
            <svg aria-hidden="true" class="w-8 h-8 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M9 5h6M9 3h6a2 2 0 0 1 2 2v1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h1V5a2 2 0 0 1 2-2z"/>
              <path d="M9 14l2 2 4-4"/>
            </svg>
          </div>
          <div>
            <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939]">Diagnostic expert et installation garantie</h3>
            <p class="text-sm text-[#475569] mt-1">Évaluation sur place pour la solution optimale</p>
          </div>
        </div>

        <div class="space-y-3 mb-6">
          <div class="flex items-center text-sm">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 2l2.39 4.84 5.34.78-3.86 3.76.91 5.31L10 14.77 4.22 16.69l.91-5.31L1.27 7.62l5.34-.78L10 2z" clip-rule="evenodd"/>
            </svg>
            <span class="text-[#1E2939] font-medium">Garantie installation 2 ans</span>
          </div>
          <div class="flex items-center text-sm">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-[#1E2939] font-medium">Matériaux professionnels inox/résines UV</span>
          </div>
          <div class="flex items-center text-sm">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-[#1E2939] font-medium">Installation réversible si besoin</span>
          </div>
        </div>

        <Button
          href="#formulaire"
          variant="tertiary"
          size="lg"
          class="w-full"
        >
          Diagnostic gratuit
          <svg aria-hidden="true" class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </Button>
      </article>

    </div>

    <!-- Témoignage client -->
    <div class="max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl border border-[#E5E7EB] p-6 lg:p-8 shadow-sm">
        <div class="flex items-start">
          <div class="flex-1">
            <div class="flex items-center mb-2">
              <div class="flex text-yellow-400 mr-3">
                {Array.from({length: 5}, (_, i) => (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" key={i}>
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <span class="text-sm text-[#475569] font-medium">Google</span>
            </div>
            <h4 class="font-semibold text-[#1E2939] mb-1">Françoise DAVENNE</h4>
            <p class="text-sm text-[#475569] mb-4">Septembre 2025</p>
            <blockquote class="text-[#475569] italic text-sm md:text-base">
              "KLINOVA Nettoyage est à l'écoute de nos besoins. Prestations de qualité et travail soigné. Je conseillerais KLINOVA Nettoyage dans mon entourage."
            </blockquote>
          </div>
        </div>
      </div>
    </div>

    <!-- Note: PAS de bloc de redirection vers /nettoyage-balcons-fientes-pigeons sur les pages locales -->

  </div>
</section>