---
// src/components/pricing/PricingMoquettes.astro
import type { ServiceConfig, PricingTier } from "~/types/geo";

import { aVille } from "~/lib/geo-klinova";

interface Props {
  cityName?: string;
  service: ServiceConfig;
}


const { cityName, service } = Astro.props;


const cityAt = cityName ? aVille(cityName) : "";


const cityAtText = cityName ? aVille(cityName) : "à Paris & IDF";



const tiers: PricingTier[] = Array.isArray(service.pricingTiers)
  ? (service.pricingTiers as PricingTier[])
  : [];

// Helpers pour récupérer les tiers attendus
const fromTier = tiers.find((t) => t.priceType === "from") as
  | Extract<PricingTier, { priceType: "from" }>
  | undefined;

const rangeTier = tiers.find((t) => t.priceType === "range") as
  | Extract<PricingTier, { priceType: "range" }>
  | undefined;

const quoteTier = tiers.find((t) => t.priceType === "quote") as
  | Extract<PricingTier, { priceType: "quote" }>
  | undefined;

// Formatage simple
const formatVat = (vatIncluded?: boolean) => (vatIncluded === false ? "HT" : "TTC");
const formatRangeUnit = (unitCode?: string) => (unitCode === "MTK" ? "/m²" : "");
---

<section class="py-16 bg-white border-y border-neutral-100" id="tarifs">
  <div class="container-responsive">
    <!--En-tête : On adresse les deux cibles -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-50 border border-green-100 text-[#3F8D65] text-xs font-bold uppercase tracking-wide mb-4">
        Particuliers & Professionnels
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-[#1E2939] mb-6">
        Tarifs nettoyage moquette
        {cityName && <span class="text-[#3F8D65]"> {cityAt}</span>}
      </h2>
      <p class="text-xl text-[#475569] max-w-4xl mx-auto leading-relaxed">
        Que ce soit pour un salon, un couloir d'immeuble ou un plateau de bureaux.
        Des solutions adaptées à chaque surface et type de fibre.
      </p>
    </div>

    <!--Grille tarifaire Hybride -->
    <div class="max-w-6xl mx-auto mb-12">
      <div class="bg-[#FCFCFC] rounded-2xl p-8 border border-[#E5E7EB]">
        <div class="grid md:grid-cols-3 gap-6 mb-8">

          <!--CARTE 1 : PARTICULIERS (Forfaitaire) -->
          <div class="bg-white rounded-xl p-6 border border-[#E5E7EB] text-center hover:shadow-lg transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-blue-400 group-hover:h-1.5 transition-all"></div>
            <div class="w-16 h-16 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <span class="text-2xl">🏠</span>
            </div>

            <h4 class="text-lg font-bold text-[#1E2939] mb-1">
              {fromTier?.name ?? "Nettoyage de moquette à domicile"}
            </h4>
            <p class="text-xs text-[#94A3B8] uppercase font-bold tracking-wider mb-3">
              Offre Particulier
            </p>

            {fromTier ? (
              <>
                <div class="text-2xl font-bold text-[#1E2939] mb-2">Forfaits fixes</div>
                <p class="text-sm text-[#64748B]">
                  Dès {fromTier.from}€ {formatVat(fromTier.vatIncluded)}
                </p>
              </>
            ) : (
              <>
                <div class="text-2xl font-bold text-[#1E2939] mb-2">Sur devis</div>
                <p class="text-sm text-[#64748B]">Selon surface et état</p>
              </>
            )}

            <div class="mt-4 border-t border-dashed border-gray-200 pt-4">
              <p class="text-xs text-[#475569] italic">
                {fromTier?.description ??
                  "Idéal pour : tapis, chambres, salon, escaliers privatifs."}
              </p>
            </div>
          </div>

          <!--CARTE 2 : PRO & COPRO (Au m²) -->
          <div class="bg-white rounded-xl p-6 border-2 border-[#3F8D65]/20 text-center shadow-md relative overflow-hidden transform md:-translate-y-2">
            <div class="absolute top-0 right-0 bg-[#3F8D65] text-white text-[10px] font-bold px-2 py-1 rounded-bl-lg">
              Populaire
            </div>
            <div class="w-16 h-16 bg-[#DFF1E8] text-[#3F8D65] rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl">🏢</span>
            </div>

            <h4 class="text-lg font-bold text-[#1E2939] mb-1">
              {rangeTier?.name ?? "Parties communes"}
            </h4>
            <p class="text-xs text-[#3F8D65] uppercase font-bold tracking-wider mb-3">
              Offre Copropriété
            </p>

            {rangeTier ? (
              <>
                <div class="text-3xl font-bold text-[#3F8D65] mb-2">
                  {rangeTier.low} - {rangeTier.high}€
                  <span class="text-sm font-normal text-gray-500">
                    {formatRangeUnit(rangeTier.unitCode)}
                  </span>
                </div>
                <p class="text-xs text-[#475569]">Dégressif selon surface</p>
              </>
            ) : (
              <>
                <div class="text-3xl font-bold text-[#3F8D65] mb-2">Sur devis</div>
                <p class="text-xs text-[#475569]">Selon surface et contraintes</p>
              </>
            )}

            <div class="mt-4 border-t border-dashed border-[#3F8D65]/30 pt-4">
              <p class="text-xs text-[#475569] italic">
                {rangeTier?.description ??
                  "Idéal pour : couloirs d'immeubles, paliers, halls d'entrée."}
              </p>
            </div>
          </div>

          <!--CARTE 3 : GRANDS COMPTES (Sur mesure) -->
          <div class="bg-white rounded-xl p-6 border border-[#E5E7EB] text-center hover:shadow-lg transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-[#1E2939] group-hover:h-1.5 transition-all"></div>
            <div class="w-16 h-16 bg-gray-100 text-[#1E2939] rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <span class="text-2xl">🏭</span>
            </div>

            <h4 class="text-lg font-bold text-[#1E2939] mb-1">
              {quoteTier?.name ?? "Grands plateaux"}
            </h4>
            <p class="text-xs text-gray-500 uppercase font-bold tracking-wider mb-3">
              Offre Bureaux / Hôtels
            </p>

            <div class="text-2xl font-bold text-[#1E2939] mb-2">Sur devis</div>
            <p class="text-sm text-[#64748B]">Étude technique offerte</p>

            <div class="mt-4 border-t border-dashed border-gray-200 pt-4">
              <p class="text-xs text-[#475569] italic">
                {quoteTier?.description ??
                  "Idéal pour : open-spaces, moquettes collées, > 100m²."}
              </p>
            </div>
          </div>
        </div>

        <!--Facteurs de prix (Universel) -->
        <div class="bg-amber-50 rounded-xl p-6 border border-amber-200">
          <h4 class="font-bold text-amber-900 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Ce qui fait varier le devis {cityAt}
          </h4>

          <div class="grid md:grid-cols-2 gap-4 text-sm text-amber-800">
            <ul class="space-y-1">
              <li>• <strong>Type de fibre :</strong> Laine (délicat) vs Synthétique (standard).</li>
              <li>• <strong>Meubles :</strong> Pièces vides vs pièces encombrées.</li>
            </ul>
            <ul class="space-y-1">
              <li>• <strong>État :</strong> Taches spécifiques (café, urine, tanin) vs entretien.</li>
              <li>• <strong>Accès :</strong> Étage sans ascenseur ou stationnement difficile.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!--Section Avantages Ciblés (B2C vs B2B) -->
    <div class="grid md:grid-cols-2 gap-8 mb-12 max-w-5xl mx-auto">
      <!--Colonne Particuliers (Crédit d'Impôt) -->
      <div class="flex gap-4">
        <div class="shrink-0 w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 text-xl">
          🏠
        </div>
        <div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="font-bold text-[#1E2939]">Pour les Particuliers</h3>
            <span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full border border-green-200">
              -50% d'Impôt
            </span>
          </div>

          <ul class="space-y-2 text-sm text-[#475569]">
            <li class="flex items-start gap-2 font-semibold text-[#1E2939]">
              <span class="text-green-500 text-lg leading-none">✓</span>
              <span>Eligible Crédit d'Impôt 50%*</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500 text-lg leading-none">✓</span>
              Traitement anti-acariens & allergènes
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500 text-lg leading-none">✓</span>
              Suppression odeurs (animaux, tabac)
            </li>
          </ul>
        </div>
      </div>

      <!--Colonne Pros -->
      <div class="flex gap-4">
        <div class="shrink-0 w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-green-600 text-xl">
          💼
        </div>
        <div>
          <h3 class="font-bold text-[#1E2939] mb-2">Pour les Pros & Syndics</h3>
          <ul class="space-y-2 text-sm text-[#475569]">
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span> Intervention soirs ou week-ends
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span> TVA récupérable (facture pro)
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span> Rapport d'intervention détaillé
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!--CTA final -->
    <div class="text-center">
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-[#3F8D65] rounded-full hover:bg-[#357a53] hover:shadow-lg transition-all transform hover:-translate-y-0.5"
      >
        Obtenir mon chiffrage précis
      </a>
      <p class="mt-4 text-sm text-[#94A3B8]">
        Réponse sous 24h • Intervention {cityAtText} ?

      </p>
    </div>
  </div>
</section>
