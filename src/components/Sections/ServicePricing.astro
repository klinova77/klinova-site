---
import type { ServiceConfig, City } from "~/types/geo";
import { aVille, deVille } from "~/lib/geo-klinova";

interface Props {
  service: ServiceConfig;
  city: City;
}

const { service, city } = Astro.props as Props;

// Sécurité : Si pas de prix configuré, on n'affiche pas la section
if (!service.pricing) return null;

const cityAt = aVille(city.name);
const cityFrom = deVille(city.name);

const priceValue = service.pricing.from; // ex: "15 €"
const priceUnit = service.pricing.unit;  // ex: "par m²"
---


<section class="py-16 bg-white border-b border-neutral-100" id="tarifs">
  <div class="container-responsive max-w-5xl mx-auto">
    
    {/* Header SEO : On place les mots clés "Tarifs" + Service + Ville */}
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-50 border border-green-100 text-[#3F8D65] text-xs font-bold uppercase tracking-wide mb-4">
        Transparence tarifaire
      </div>
      <h2 class="text-3xl font-bold text-[#1E2939] mb-4">
        Tarifs {service.name.toLowerCase()} {cityAt}</span>
      </h2>
      <p class="text-[#64748B] max-w-2xl mx-auto text-lg">
        Une tarification claire, sans frais cachés. Le prix final dépend de la surface et de l'état d'encrassement constaté sur place.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-stretch">
      
      {/* CARTE 1 : INTERVENTION PONCTUELLE (Celle qui utilise ton "15€") */}
      <div class="flex flex-col bg-white border border-neutral-200 rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all duration-300 relative group">
        {/* Liseré vert au survol */}
        <div class="absolute top-0 left-0 w-full h-1 bg-neutral-100 group-hover:bg-[#3F8D65] transition-colors"></div>

        <h3 class="font-bold text-[#1E2939] text-xl mb-2">Intervention Ponctuelle</h3>
        <p class="text-sm text-[#64748B] mb-6">Remise en état, fin de chantier, sinistre.</p>
        
        <div class="mb-6">
          <div class="flex items-baseline gap-2">
            <span class="text-sm text-[#64748B] font-medium">À partir de</span>
            <span class="text-5xl font-extrabold text-[#3F8D65] tracking-tight">{priceValue}</span>
          </div>
          <p class="text-sm text-[#64748B] font-medium mt-1">
            {priceUnit} traité
            {/* Mention légale pour filtrer les petits paniers */}
            <span class="block text-xs text-neutral-400 font-normal mt-1">*Forfait minimum d'intervention applicable</span>
          </p>
        </div>

        <div class="space-y-4 mb-8 flex-grow">
          <p class="text-sm font-semibold text-[#1E2939]">Ce tarif inclut :</p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm text-[#475569]">
              <svg class="w-5 h-5 text-[#3F8D65] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Déplacement sur <strong>{city.name}</strong></span>
            </li>
            <li class="flex items-start gap-3 text-sm text-[#475569]">
              <svg class="w-5 h-5 text-[#3F8D65] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Produits professionnels & Matériel</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-[#475569]">
              <svg class="w-5 h-5 text-[#3F8D65] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Main d'œuvre qualifiée</span>
            </li>
          </ul>
        </div>

        <a href="/contact" class="block w-full text-center py-4 rounded-xl border-2 border-[#3F8D65] text-[#3F8D65] font-bold hover:bg-[#3F8D65] hover:text-white transition-all duration-300">
          Obtenir mon devis précis
        </a>
      </div>

      {/* CARTE 2 : CONTRAT CADRE (B2B / Syndic) */}
      <div class="flex flex-col bg-[#1E2939] rounded-2xl p-8 shadow-xl text-white relative overflow-hidden">
        {/* Badge */}
        <div class="absolute top-5 right-5 bg-[#3F8D65] text-white text-[10px] uppercase font-bold px-3 py-1 rounded-full tracking-wider">
          Recommandé Syndic
        </div>

        <h3 class="font-bold text-white text-xl mb-2">Contrat d'Entretien</h3>
        <p class="text-sm text-gray-400 mb-6">Passages réguliers & grands volumes.</p>
        
        <div class="mb-6">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-extrabold text-white tracking-tight">Sur Mesure</span>
          </div>
          <p class="text-sm text-[#3F8D65] font-bold mt-1">
            Tarifs dégressifs au volume
          </p>
        </div>

        <div class="space-y-4 mb-8 flex-grow">
          <p class="text-sm font-semibold text-gray-200">Avantages contrat :</p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm text-gray-300">
              <svg class="w-5 h-5 text-[#3F8D65] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Prix bloqué à l'année</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-gray-300">
              <svg class="w-5 h-5 text-[#3F8D65] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Priorité d'intervention en cas d'urgence</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-gray-300">
              <svg class="w-5 h-5 text-[#3F8D65] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Facturation mensuelle lissée</span>
            </li>
          </ul>
        </div>

        <a href="/contact" class="block w-full text-center py-4 rounded-xl bg-[#3F8D65] text-white font-bold hover:bg-[#357a53] transition-all duration-300 shadow-lg shadow-[#3F8D65]/20 hover:shadow-[#3F8D65]/40 hover:-translate-y-0.5">
          Demander une visite sur site
        </a>
      </div>

    </div>

    {/* BLOC SEO TEXTUEL (Pour ranker sur "Prix nettoyage X") */}
    <div class="mt-12 bg-neutral-50 rounded-xl p-6 border border-neutral-200 text-sm text-[#64748B] leading-relaxed">
      <p class="mb-2">
        <strong class="text-[#1E2939]">Comment est calculé le prix pour {service.name.toLowerCase()} ?</strong>
      </p>
      <p>
        Le tarif indiqué ({priceValue} {priceUnit}) est une base de référence pour une prestation standard {cityAt}. 
        Le coût final peut varier selon plusieurs critères techniques : l'accessibilité de la zone (étage sans ascenseur, hauteur sous plafond), 
        l'état d'ancienneté des revêtements, ou la nécessité de traitements spécifiques (détachage intensif, imperméabilisation). 
        Un devis précis est systématiquement établi avant toute intervention.
      </p>
    </div>

  </div>
</section>