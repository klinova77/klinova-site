---
import Button from "~/components/UI/Button.astro";
import type { ParkingCommercialPricing } from "~/types/geo";
import { aVille, deVille } from "~/lib/geo-klinova";
import {
  formatFrenchList,
  formatLargeParkingPricingWithoutFloor,
  formatParkingAmount,
  formatParkingRange,
} from "~/lib/parking-pricing";

interface Props {
  cityName?: string;
  commercialPricing: ParkingCommercialPricing;
}

const { cityName, commercialPricing } = Astro.props as Props;

const cityAt = cityName ? aVille(cityName) : "";
const cityFrom = cityName ? deVille(cityName) : "";
const citySuffix = cityAt ? ` ${cityAt}` : "";

const standardRangeText = formatParkingRange(commercialPricing.standardParking);
const largeParkingText = formatLargeParkingPricingWithoutFloor(
  commercialPricing.largeParking,
);
const individualMinimumText = formatParkingAmount(
  commercialPricing.individualMinimum,
);
const individualApplicationsText = formatFrenchList(
  commercialPricing.individualMinimum.appliesTo,
  "ou",
);
---

<section class="bg-white py-16 md:py-20 border-y border-neutral-100" data-section="tarifs" id="tarifs">
  <div class="container-responsive">
    <div class="max-w-4xl mb-12 text-center mx-auto">
      <div
        class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-wide mb-6
               bg-blue-50 border-blue-100 text-[#1E40AF]"
      >
        <span class="block h-2 w-2 rounded-full bg-[#1E40AF] animate-pulse" aria-hidden="true"></span>
        Transparence tarifaire
      </div>

      <h2 class="text-3xl md:text-4xl font-bold text-[#1E2939] leading-tight mb-4">
        Coût du nettoyage de parking <span class="text-[#3F8D65]">{citySuffix}</span>
      </h2>

      <p class="text-lg text-[#475569] max-w-3xl mx-auto">
        Pour les parkings collectifs de taille courante {cityFrom}, les prix se situent généralement de
        <strong>{standardRangeText}</strong>. Le devis précise les opérations retenues selon la configuration du site.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-6 items-stretch">
      <article class="rounded-2xl border border-[#E5E7EB] bg-white p-8 shadow-sm">
        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mb-4 text-2xl">🚗</div>
        <h3 class="text-lg font-bold text-[#1E2939] mb-3">Parkings courants</h3>
        <div class="inline-flex rounded-md bg-[#EEF2FF] border border-[#C7D2FE] px-3 py-2 text-lg font-bold text-[#1E40AF] mb-4">
          {standardRangeText}
        </div>
        <p class="text-sm text-[#475569] leading-relaxed">
          Fourchette indicative pour les parkings collectifs ou professionnels de taille courante. Les opérations ne sont
          pas systématiquement toutes incluses.
        </p>
      </article>

      <article class="rounded-2xl border-2 border-[#3F8D65]/20 bg-[#F0FDF4]/30 p-8 shadow-sm">
        <div class="w-12 h-12 bg-[#3F8D65]/10 text-[#3F8D65] rounded-full flex items-center justify-center mb-4 text-2xl">🏭</div>
        <h3 class="text-lg font-bold text-[#1E2939] mb-3">Grands et très grands parkings</h3>
        <p class="text-sm text-[#1E2939] leading-relaxed font-medium">
          {largeParkingText}
        </p>
      </article>

      <article class="rounded-2xl border border-[#E5E7EB] bg-white p-8 shadow-sm">
        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mb-4 text-2xl">🧰</div>
        <h3 class="text-lg font-bold text-[#1E2939] mb-3">Prestations lourdes</h3>
        <div class="text-xl font-bold text-[#1E2939] mb-3">Sur devis</div>
        <p class="text-sm text-[#475569] leading-relaxed mb-4">
          Sur devis selon l’état du site et les opérations nécessaires.
        </p>
        <ul class="space-y-1.5 text-xs text-[#64748B]">
          {commercialPricing.heavyCleaning.operations.slice(0, 4).map((operation) => (
            <li>• {operation}</li>
          ))}
        </ul>
      </article>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mt-12">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
        <h4 class="text-base font-bold text-amber-900 mb-3">Ce qui fait varier le devis {citySuffix}</h4>
        <ul class="space-y-2 text-sm text-amber-800">
          {commercialPricing.standardParking.factors.map((factor) => (
            <li class="flex gap-2"><span aria-hidden="true">•</span><span>{factor}</span></li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-[#E5E7EB] bg-white p-6">
        <h4 class="text-base font-bold text-[#1E2939] mb-2">Places, box et petites surfaces pour particuliers</h4>
        <p class="text-sm text-[#475569] leading-relaxed">
          Pour {individualApplicationsText}, le <strong>minimum d’intervention est de {individualMinimumText}</strong>.
          Le montant définitif dépend des opérations nécessaires et est précisé
          {commercialPricing.individualMinimum.tax} dans le devis.
        </p>

        <div class="mt-5 pt-5 border-t border-[#E5E7EB]">
          <h5 class="text-sm font-semibold text-[#1E2939] mb-1">Petite surface professionnelle</h5>
          <p class="text-sm text-[#475569]">
            Tarification sur devis selon le périmètre et les conditions d’intervention.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <Button
        href="#formulaire"
        label={`Demander un devis parking ${citySuffix}`}
        variant="primary"
        size="lg"
        tracking={{ action: 'cta_tarifs', source: 'section_tarifs', intent: 'lead' }}
        data={{ section: 'tarifs' }}
        ariaLabel={`Demander un devis adapté pour le nettoyage de parking ${citySuffix}`}
        className="bg-[#3F8D65] hover:bg-[#357a53] text-white shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all"
      />
      <p class="text-sm text-[#64748B] mt-4">
        Proposition établie selon la surface, l’état et l’organisation du site
      </p>
    </div>
  </div>
</section>
