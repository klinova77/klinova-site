---
import { Image } from 'astro:assets';
import Button from '~/components/UI/Button.astro';
import type { City } from '~/types/geo';

import picsAntiPigeons from '~/assets/images/pics-anti-pigeons-inox-balcon.webp';
import filetAntiPigeons from '~/assets/images/filet-anti-pigeons-pour-balcon.jpg';
import gelRepulsif from '~/assets/images/gel-repulsif-anti-pigeon-coupelles.jpg';

interface Props {
  city?: City;          // 🔹 devient optionnel
  cityName?: string;    // 🔹 string de secours
  isLocal?: boolean;    // true = page locale, false = page globale
}

const { city, cityName, isLocal: isLocalProp } = Astro.props;

// 🔹 On dérive un "label" de ville et un flag local/global robustes
const isLocal = !!city && (isLocalProp ?? true);
const cityLabel = city?.name ?? cityName ?? 'Île-de-France';
---




<!-- Section 1: Types d'interventions -->
<section id="types-interventions" class="bg-[#F8FDF9] py-16 lg:py-24">
  <div class="container-responsive">
    
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-[#1E2939] mb-4">
  Nos interventions de nettoyage de balcons à {cityLabel}
</h2>
<p class="text-base md:text-lg lg:text-xl text-[#475569] max-w-3xl mx-auto">
  Quelle que soit la nature des salissures, nous adaptons nos techniques pour un résultat impeccable.
</p>
      <p class="text-base md:text-lg lg:text-xl text-[#475569] max-w-3xl mx-auto">
        Quelle que soit la nature des salissures, nous adaptons nos techniques pour un résultat impeccable.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      
      <!-- Carte 1: Fientes de pigeons -->
      <article class="bg-white rounded-2xl border border-[#E5E7EB] p-6 lg:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4 bg-[#EAF6F0]">
            <svg aria-hidden="true" class="w-9 h-9 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 2s-2 1-4 1-4-1-6 3-4 6-8 7c0 0 2 2 6 2 5 0 9-3 10-6 1-3 2-7 2-7Z"/>
              <path d="M14 7s-1.5 2-5 3"/>
            </svg>
          </div>
          <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939] mb-2">
            Balcons souillés par les fientes de pigeons
          </h3>
        </div>
        <p class="text-[#475569] leading-relaxed mb-4">
          Élimination complète des fientes et désinfection virucide (EN 14476). Neutralisation des odeurs. Préparation à la pose de dispositifs anti-pigeons.
        </p>

        <!-- Lien spécialisé adapté selon contexte -->
        <div class="mb-4">
          {isLocal ? (
            <a 
                 href={`/zones-d-intervention/${city.department.slug}/${city.slug}/balcons-fientes#video`}

              class="inline-flex items-center text-sm text-[#3F8D65] hover:text-[#387B58] underline underline-offset-4 hover:no-underline transition-colors duration-200"
            >
              <svg aria-hidden="true" class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
              </svg>
              Voir notre méthode spécialisée
            </a>
          ) : (
            <a 
              href="/nettoyage-balcons-fientes-pigeons"
              class="inline-flex items-center text-sm text-[#3F8D65] hover:text-[#387B58] underline underline-offset-4 hover:no-underline transition-colors duration-200"
            >
              <svg aria-hidden="true" class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
              Solutions spécialisées fientes de pigeons
            </a>
          )}
        </div>
      </article>

      <!-- Carte 2: Pollution urbaine -->
      <article class="bg-white rounded-2xl border border-[#E5E7EB] p-6 lg:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4 bg-[#EAF6F0]">
            <svg aria-hidden="true" class="w-9 h-9 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.6 4.8A2.4 2.4 0 1 1 12 8H2"/>
              <path d="M17.3 9.3A2.7 2.7 0 1 1 20 13H2"/>
              <path d="M12.6 15.6A2.4 2.4 0 1 1 15 19H2"/>
            </svg>
          </div>
          <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939] mb-2">
            Balcons encrassés par la pollution urbaine
          </h3>
        </div>
        <p class="text-[#475569] leading-relaxed mb-4">
          Dépoussiérage en profondeur, dégraissage et rinçage maîtrisé. Adapté aux balcons sur rue ou cour intérieure à {cityName}.
        </p>
        <ul class="space-y-2">
          <li class="flex items-center text-sm text-[#475569]">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
            </svg>
            Redonne l'éclat d'origine aux matériaux
          </li>
          <li class="flex items-center text-sm text-[#475569]">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
            </svg>
            Techniques adaptées à chaque surface
          </li>
        </ul>
      </article>

      <!-- Carte 3: Après travaux -->
      <article class="bg-white rounded-2xl border border-[#E5E7EB] p-6 lg:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4 bg-[#EAF6F0]">
            <svg aria-hidden="true" class="w-9 h-9 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="m14 13-5 5"/>
              <path d="M15 12 20 7l-3-3-5 5"/>
              <path d="m12 9-1-1-6 6v3h3l6-6"/>
            </svg>
          </div>
          <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939] mb-2">
            Remise en état après travaux ou sinistre
          </h3>
        </div>
        <p class="text-[#475569] leading-relaxed mb-4">
          Évacuation des résidus, retrait des traces de plâtre/peinture, dégraissage et remise en état complète du balcon.
        </p>
        <ul class="space-y-2">
          <li class="flex items-center text-sm text-[#475569]">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
            </svg>
            Intervention rapide post-chantier
          </li>
          <li class="flex items-center text-sm text-[#475569]">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
            </svg>
            Évacuation sécurisée des déchets
          </li>
        </ul>
      </article>

      <!-- Carte 4: Copropriétés & tertiaire -->
      <article class="bg-white rounded-2xl border border-[#E5E7EB] p-6 lg:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4 bg-[#EAF6F0]">
            <svg aria-hidden="true" class="w-9 h-9 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="18" rx="1"/>
              <path d="M10 7h4a1 1 0 0 1 1 1v13"/>
              <path d="M14 7V3h6v18h-6"/>
              <path d="M7 7h.01M7 11h.01M7 15h.01M17 11h.01M17 15h.01"/>
            </svg>
          </div>
          <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939] mb-2">
            Copropriétés & immeubles tertiaires
          </h3>
        </div>
        <p class="text-[#475569] leading-relaxed mb-4">
          Interventions multi-niveaux sécurisées : balisage, protocole syndic, traçabilité. Possibilité de contrat annuel d'entretien.
        </p>
        <ul class="space-y-2">
          <li class="flex items-center text-sm text-[#475569]">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
            </svg>
            Devis syndic détaillé par intervention
          </li>
          <li class="flex items-center text-sm text-[#475569]">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
            </svg>
            Planning personnalisé et récurrent
          </li>
        </ul>
      </article>

    </div>

    <!-- CTA de section -->
    <div class="text-center mt-12 lg:mt-16">
      <p class="text-[#475569] mb-6">
        Une situation spécifique à {cityName} ? Parlons-en pour trouver la solution adaptée.
      </p>
      <Button
        href="#formulaire"
        variant="tertiary"
        size="lg"
        class="focus-visible:ring-2 focus-visible:ring-[#3F8D65] focus-visible:ring-offset-2"
      >
        Contactez nous
        <svg aria-hidden="true" class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </Button>
    </div>
  </div>
</section>

<!-- Section 2: Solutions anti-pigeons -->
<section id="anti-pigeons" class="bg-[#DFF1E8] py-16 lg:py-24">
  <div class="container-responsive">
    
    <!-- En-tête -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-[#1E2939] mb-4">
        Solutions anti-pigeons adaptées à votre balcon à {cityName}
      </h2>
      <p class="text-base md:text-lg lg:text-xl text-[#475569] max-w-3xl mx-auto">
        Pics, filets ou gel répulsif : nous recommandons la meilleure solution selon votre configuration et vos contraintes esthétiques.
      </p>
    </div>

    <!-- Grille 2x2 : 3 options + 1 carte diagnostic -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-12">
      
      <!-- Carte: Pics -->
      <article class="group bg-white rounded-2xl border border-[#E5E7EB] overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <figure class="aspect-[4/3] bg-gray-50 overflow-hidden">
          <Image
            src={picsAntiPigeons}
            alt="Pics anti-pigeons en inox posés sur un rebord de balcon"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            formats={['avif','webp','jpeg']}
            quality={86}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </figure>

        <div class="p-6 lg:p-8">
          <div class="flex items-start mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[#EAF6F0] mr-3 flex-shrink-0">
              <svg aria-hidden="true" class="w-6 h-6 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M3 7l5 5 4-8 4 8 5-5v10H3z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939]">Pics anti-pigeons inox</h3>
              <p class="text-sm text-[#475569] mt-1">Rebords étroits, appuis de fenêtre, climatiseurs</p>
            </div>
          </div>
          <ul class="space-y-2 text-[#475569]">
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Discrets et durables (inox qualité marine)
            </li>
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Efficacité immédiate, entretien minimal
            </li>
          </ul>
        </div>
      </article>

      <!-- Carte: Filets -->
      <article class="group bg-white rounded-2xl border border-[#E5E7EB] overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <figure class="aspect-[4/3] bg-gray-50 overflow-hidden">
          <Image
            src={filetAntiPigeons}
            alt="Filet anti-pigeons discret tendu sur une ouverture de balcon"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            formats={['avif','webp','jpeg']}
            quality={86}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </figure>

        <div class="p-6 lg:p-8">
          <div class="flex items-start mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[#EAF6F0] mr-3 flex-shrink-0">
              <svg aria-hidden="true" class="w-6 h-6 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939]">Filets de protection</h3>
              <p class="text-sm text-[#475569] mt-1">Grandes ouvertures, coursives, puits de lumière</p>
            </div>
          </div>
          <ul class="space-y-2 text-[#475569]">
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Protection intégrale, empêche tout accès
            </li>
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Maille et teinte au choix (discrétion)
            </li>
          </ul>
        </div>
      </article>

      <!-- Carte: Gel -->
      <article class="group bg-white rounded-2xl border border-[#E5E7EB] overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <figure class="aspect-[4/3] bg-gray-50 overflow-hidden">
          <Image
            src={gelRepulsif}
            alt="Coupelles de gel répulsif anti-pigeons posées sur un rebord"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            formats={['avif','webp','jpeg']}
            quality={86}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </figure>

        <div class="p-6 lg:p-8">
          <div class="flex items-start mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[#EAF6F0] mr-3 flex-shrink-0">
              <svg aria-hidden="true" class="w-6 h-6 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 2.69l5.66 5.66a8 8 0 11-11.32 0L12 2.69z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939]">Gel répulsif professionnel</h3>
              <p class="text-sm text-[#475569] mt-1">Usage ponctuel ou complément d'autres solutions</p>
            </div>
          </div>
          <ul class="space-y-2 text-[#475569]">
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Application rapide, renouvellement possible
            </li>
            <li class="flex items-start text-sm">
              <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
              </svg>
              Discret, ne tache pas les supports
            </li>
          </ul>
        </div>
      </article>

      <!-- Carte: Diagnostic & garantie -->
      <article class="bg-[#F8FDF9] rounded-2xl border border-[#C0E2D0] p-6 lg:p-8">
        <div class="flex items-start mb-6">
          <div class="flex items-center justify-center w-16 h-16 rounded-2xl bg-[#EAF6F0] mr-4 flex-shrink-0">
            <svg aria-hidden="true" class="w-8 h-8 text-[#3F8D65]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M9 5h6M9 3h6a2 2 0 0 1 2 2v1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h1V5a2 2 0 0 1 2-2z"/>
              <path d="M9 14l2 2 4-4"/>
            </svg>
          </div>
          <div>
            <h3 class="text-xl lg:text-2xl font-bold text-[#1E2939]">Diagnostic expert et installation garantie</h3>
            <p class="text-sm text-[#475569] mt-1">Évaluation sur place pour la solution optimale</p>
          </div>
        </div>

        <div class="space-y-3 mb-6">
          <div class="flex items-center text-sm">
            <svg aria-hidden="true" class="w-4 h-4 text-[#3F8D65] mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 2l2.39 4.84 5.34.78-3.86 3.76.91 5.31L10 14.77 4.22 16.69l.91-5.31L1.27 7.62l5.34-.78L10 2z" clip-rule="evenodd"/>
            </svg>
            <span class="text-[#1E2939] font-medium">Garantie installation 2 ans</span>
          </div>
