---
interface Props {
  cityName: string;
  bullets?: string[];
}

const { cityName, bullets = [] } = Astro.props;
---

{bullets.length > 0 && (
  <section class="py-16 bg-gradient-to-br from-[#FCFCFC] to-white border-y border-[#E5E7EB]">
    <div class="container-responsive">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1E2939] mb-4">
            Pourquoi nous choisir à {cityName} ?
          </h2>
          <p class="text-lg text-[#475569] max-w-2xl mx-auto">
            Quelques raisons concrètes de faire appel à Klinova dans votre secteur.
          </p>
        </div>

        <div class="space-y-4">
          {bullets.map((item) => (
            <div class="flex items-start gap-3 bg-white border border-[#E5E7EB] rounded-xl p-4">
              <span class="mt-1 w-2 h-2 rounded-full bg-[#3F8D65] flex-shrink-0"></span>
              <p class="text-[#475569] leading-relaxed">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
