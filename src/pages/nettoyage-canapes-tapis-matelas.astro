<script is:inline>
  (() => {
    const TARGET_SELECTOR = ".sk-ww-google-reviews";
    const SCRIPT_SRC = "https://widgets.sociablekit.com/google-reviews/widget.js";

    function injectScriptOnce() {
      if (window.__SK_WIDGET_SCRIPT_LOADED) return;
      window.__SK_WIDGET_SCRIPT_LOADED = true;

      // évite double ajout si déjà présent dans le DOM
      if (document.querySelector(`script[src="${SCRIPT_SRC}"]`)) return;

      const s = document.createElement("script");
      s.src = SCRIPT_SRC;
      s.defer = true;
      document.body.appendChild(s);
    }

    function init() {
      const target = document.querySelector(TARGET_SELECTOR);
      if (!target) return;

      if (!("IntersectionObserver" in window)) {
        injectScriptOnce();
        return;
      }

      const observer = new IntersectionObserver(
        (entries, obs) => {
          if (entries.some((e) => e.isIntersecting)) {
            injectScriptOnce();
            obs.disconnect();
          }
        },
        { rootMargin: "200px 0px" }
      );

      observer.observe(target);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>


