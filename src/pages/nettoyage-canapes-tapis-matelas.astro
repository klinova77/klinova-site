  <!-- Forme décorative unique -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-[#3F8D65]/5 rounded-full blur-3xl floating-shape" aria-hidden="true"></div>
</section>



<!-- Section 2: Les situations les plus fréquentes -->
<section class="py-16 bg-white" data-activate-floating-cta>
  <div class="container-responsive">
    
    <!-- Petit titre contextuel -->
    <div class="text-center mb-6">
      <p class="text-sm font-semibold text-[#3F8D65] uppercase tracking-wide mb-3">
