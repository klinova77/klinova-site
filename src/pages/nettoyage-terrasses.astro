---
export const prerender = true;
import LayoutWithCTA from "~/layouts/LayoutWithCTA.astro";
import { Image } from "astro:assets";
import Button from "~/components/UI/Button.astro";
import ButtonSubmit from '~/components/UI/ButtonSubmit.astro';
import { Accordion, AccordionItem } from "free-astro-components";

import DepartmentCardsKln from "~/components/local/DepartmentCardsKln.astro";

// ⚠️ Remplace par ton image réelle (terrasse / sol extérieur)
// Exemple de nom à créer dans src/assets/images/
import heroTerrassesImage from "~/assets/images/nettoyage-terrasses-sol-exterieur-avant-apres-visuel.webp";


// Variables de base
const site = "https://klinova.fr";
const pageUrl = "/nettoyage-terrasses";
const pageName = "Nettoyage de terrasses";

// Configuration popup
const popupContext = {
  title: "Demander à être rappelé",
  subtitle: "Un expert Klinova vous rappelle pour estimer le nettoyage de votre terrasse.",
  serviceKey: "rappel-nettoyage-terrasses",
  serviceLabel: "Demande rappel - Page nettoyage-terrasses",
  trackingSource: "popup-nettoyage-terrasses-header",
  presetSubject: "Nouvelle demande de rappel – nettoyage-terrasses",
  creditImpotEnabled: true,
};

// FAQ (mix core + long tail, SEO pack)
const faq = [
  {
    title: "Quels types de terrasses nettoyez-vous ?",
    content:
      "Nous intervenons sur la plupart des revêtements extérieurs : béton (brut ou lissé), carrelage/grès cérame, pierre naturelle (travertin, calcaire) ou reconstituée, pavés/dallage, bois et bois composite. La méthode dépend du matériau, de l’état de surface et de l’exposition (UV, humidité, pollution).",
  },
  {
    title: "Enlevez-vous la mousse, les algues et les traces noires ?",
    content:
      "Oui, selon le support et le niveau d’encrassement. Nous traitons les mousses, algues, lichens (biofilm) ainsi que les traces noires liées à la pollution, au ruissellement et à l’humidité. L’objectif est d’obtenir une terrasse plus nette, sans abîmer le revêtement ni les joints.",
  },
  {
    title: "Utilisez-vous la haute pression ?",
    content:
      "Pas comme solution “universelle”. Selon le revêtement, nous privilégions un nettoyage mécanique contrôlé (brossage/monobrosse) et une chimie adaptée, avec un rinçage maîtrisé. Une basse ou moyenne pression peut être utilisée si c’est pertinent, notamment pour préserver les joints, le bois et les pierres tendres.",
  },
  {
    title: "Pouvez-vous traiter les taches grasses (barbecue, repas) et les coulures ?",
    content:
      "Oui, dans la plupart des cas. Les graisses alimentaires, taches de jardinières, tanins (feuilles), coulures et zones de passage qui foncent se traitent avec une combinaison produit + action mécanique adaptée. Le résultat dépend de la porosité du support, de l’ancienneté de la tache et des réparations éventuelles.",
  },
  {
    title: "La terrasse devient-elle moins glissante après nettoyage ?",
    content:
      "Souvent, oui, surtout quand la glissance vient d’un biofilm humide (algues/mousses). Un nettoyage régulier limite les dépôts biologiques responsables des surfaces glissantes et de l’aspect terne. Nous évitons toutefois les promesses chiffrées ou “normées” si ce n’est pas mesuré.",
  },
  {
    title: "Proposez-vous une protection (hydrofuge / anti-tache) ?",
    content:
      "En option, selon le support et le besoin. Une protection peut aider à limiter l’absorption sur certains matériaux poreux et faciliter l’entretien. L’objectif est de protéger et de prolonger l’effet visuel, sans promesse “anti-salissure définitive”.",
  },
];

const faqLongTail = [
  {
    title: "Quel est le prix d’un nettoyage de terrasse ?",
    content:
      "Le tarif dépend surtout de la surface, du revêtement, du niveau d’encrassement (mousses, taches grasses, traces noires), de l’accès et des contraintes de rinçage. Un devis gratuit permet de cadrer précisément la méthode, la durée et le budget, sans engagement.",
  },
  {
    title: "Intervenez-vous en copropriété (terrasses communes, cours intérieures) ?",
    content:
      "Oui. Nous intervenons sur des espaces extérieurs de copropriété (terrasses communes, circulations extérieures, cours) avec une organisation adaptée : protection des abords, rinçage maîtrisé et coordination sur site.",
  },
  {
    title: "Faites-vous le dégrisage d’une terrasse en bois ?",
    content:
      "Lorsque c’est adapté, oui. Le dégrisage combine un produit dégrisant et une action mécanique contrôlée. Le résultat dépend du type de bois, de l’ancienneté, de l’exposition UV et de l’état de surface. Nous évitons de promettre une uniformité parfaite sur des lames anciennes ou réparées.",
  },
  {
    title: "Pouvez-vous intervenir pour une terrasse de café/restaurant de proximité ?",
    content:
      "Oui, sur des terrasses de petits établissements (café/restaurant de proximité) lorsque la configuration est compatible. Le traitement vise surtout les graisses, traces de passage et l’aspect terne, avec des méthodes adaptées au revêtement.",
  },
];

const faqs = [...faq, ...faqLongTail];

// Schema FAQ
const faqSchema = {
  '@type': 'FAQPage',

  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.title,

    acceptedAnswer: {
      '@type': 'Answer',
      text: item.content,
    },
  })),
};

/* -------------------------------------------------------------------------- */
/* Fil d'Ariane                                                               */
/* -------------------------------------------------------------------------- */

const breadcrumb = {
  '@type': 'BreadcrumbList',

  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: `${site}/`,
    },

    {
      '@type': 'ListItem',
      position: 2,
      name: 'Nettoyage de terrasses',
      item: `${site}${pageUrl}`,
    },
  ],
};

/* -------------------------------------------------------------------------- */
/* IDs                                                                        */
/* -------------------------------------------------------------------------- */

const serviceId = `${site}${pageUrl}#service`;
const webpageId = `${site}${pageUrl}#webpage`;

/* -------------------------------------------------------------------------- */
/* JSON-LD                                                                    */
/* -------------------------------------------------------------------------- */

const jsonLd = [
  {
    '@type': 'WebPage',

    '@id': webpageId,

    url: `${site}${pageUrl}`,

    name:
      'Nettoyage de terrasses — Klinova',

    description:
      "Nettoyage professionnel de terrasses et sols extérieurs : mousses, traces noires, taches grasses et encrassement. Méthodes adaptées au béton, carrelage, pierre, bois et composite.",

    isPartOf: {
      '@id': `${site}#website`,
    },

    mainEntity: {
      '@id': serviceId,
    },

    about: {
      '@id': serviceId,
    },

    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: `${site}/images/og/og-klinova-home.png`,
      width: 1200,
      height: 630,
    },

    inLanguage: 'fr-FR',
  },

  {
    '@type': 'Service',

    '@id': serviceId,

    url: `${site}${pageUrl}`,

    name:
      'Nettoyage professionnel de terrasses',

    alternateName:
      'Nettoyage et remise en état de sols extérieurs',

    serviceType:
      'Nettoyage, décrassage et remise en état de terrasses',

    description:
      "Nettoyage professionnel de terrasses et sols extérieurs : traitement des mousses, algues, traces noires, taches grasses et autres encrassements. Les méthodes sont adaptées au revêtement, à son état et aux contraintes de rinçage et d’accès.",

    provider: {
      '@id': `${site}#organization`,
    },

    brand: {
      '@id': `${site}#brand`,
    },

    areaServed: {
      '@type': 'AdministrativeArea',
      name: 'Île-de-France',
    },

    audience: {
      '@type': 'Audience',
      audienceType: [
        'Particuliers',
        'Copropriétés',
        'Professionnels',
      ],
    },

    category:
      'Nettoyage de terrasses et sols extérieurs',

    serviceOutput:
      "Terrasse nettoyée et remise en propreté selon le revêtement, son état initial et le périmètre défini au devis",
  },

  faqSchema,
  breadcrumb,
];

---

<LayoutWithCTA
  popupContext={popupContext}
  stickyEnabled={true}
  stickyShowAfter="scroll"
  hideSelector="[data-hide-floating-cta]"
  activateSelector="[data-activate-floating-cta]"
  activateDelayMs={800}
  stickyMobileOnly={true}
  pathname={Astro.url.pathname}
  pageType="service"
  title="Nettoyage professionnel de terrasses en Île-de-France | Klinova"
  description="Nettoyage de terrasses et sols extérieurs : mousses, traces noires, taches grasses, encrassement. Méthode adaptée au revêtement (béton, carrelage, pierre, bois). Intervention à Paris & Île-de-France."
  canonical={pageUrl}
  ogImage="/images/og/og-klinova-home.png"
  ogImageAlt="Klinova — Nettoyage de terrasses : décrassage et remise en état en Île-de-France"
  appendBrandToTitle={false}
  jsonLd={jsonLd}
>

<style>
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeInRight { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes float { 0%,100% { transform: translateY(0px) rotate(3deg); } 50% { transform: translateY(-10px) rotate(3deg); } }
  .hero-badge { animation: fadeInUp 0.6s ease-out forwards; }
  .hero-title { animation: fadeInUp 0.8s ease-out 0.1s forwards; opacity: 0; }
  .hero-subtitle { animation: fadeInUp 0.8s ease-out 0.2s forwards; opacity: 0; }
  .hero-list { animation: fadeInUp 0.8s ease-out 0.3s forwards; opacity: 0; }
  .hero-cta { animation: fadeInUp 0.8s ease-out 0.4s forwards; opacity: 0; }
  .hero-reassurance { animation: fadeInUp 0.8s ease-out 0.5s forwards; opacity: 0; }
  .hero-image { animation: fadeInRight 1s ease-out 0.3s forwards; opacity: 0; }

  .service-item { transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }
  .service-item:hover { transform: translateX(8px); }
  .service-item:hover .service-icon { transform: scale(1.1); color: #387B58; }
  .service-icon { transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }

  .reassurance-item { transition: all 0.3s ease; }
  .reassurance-item:hover { transform: translateY(-2px); }

  .floating-shape { animation: float 8s ease-in-out infinite; }
  .floating-shape:nth-child(2) { animation-delay: -2s; animation-duration: 10s; }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge,.hero-title,.hero-subtitle,.hero-list,.hero-cta,.hero-reassurance,.hero-image { animation: none; opacity: 1; }
    .floating-shape { animation: none; }
    .service-item:hover,.reassurance-item:hover { transform: none; }
    .service-item:hover .service-icon { transform: none; color: #387B58; }
  }
</style>

<!-- HERO -->
<section
  class="relative bg-[#DFF1E8] pt-12 pb-16 lg:pt-18 lg:pb-24 overflow-hidden"
  data-hide-floating-cta
  data-hide-header-cta
>
  <div class="container-responsive">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <div class="order-1 lg:order-1">
        <div class="inline-flex items-center px-4 py-2 bg-white/80 backdrop-blur-sm rounded-full text-sm font-medium text-[#3F8D65] border border-[#3F8D65]/20 mb-6 hero-badge">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
          </svg>
          Particuliers • copropriétés • petits pros
        </div>

        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold text-[#1E2939] leading-tight mb-6 hero-title">
          Nettoyage
          <span class="text-[#3F8D65]">de terrasses</span>
          – décrassage, démoussage et remise en état
        </h1>

        <p class="text-xl lg:text-2xl text-[#475569] leading-relaxed mb-8 hero-subtitle">
          Une méthode adaptée au revêtement pour retrouver un sol extérieur plus net, plus sûr et plus agréable à l’usage.
        </p>

        <ul class="space-y-3 mb-10 hero-list">
          <li class="flex items-center text-[#475569] service-item">
            <svg class="w-5 h-5 text-[#3F8D65] mr-3 flex-shrink-0 service-icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>Mousses, algues, lichens : nettoyage en profondeur</span>
          </li>
          <li class="flex items-center text-[#475569] service-item">
            <svg class="w-5 h-5 text-[#3F8D65] mr-3 flex-shrink-0 service-icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>Traces noires, voile terne, zones glissantes</span>
          </li>
          <li class="flex items-center text-[#475569] service-item">
            <svg class="w-5 h-5 text-[#3F8D65] mr-3 flex-shrink-0 service-icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>Pierre, bois, carrelage, béton : méthode adaptée au support</span>
          </li>
        </ul>

        <div class="flex flex-col sm:flex-row gap-4 hero-cta mt-6">
          <Button
            href="#formulaire"
            variant="tertiary"
            size="lg"
            class="border border-gray-700/80 text-gray-800 bg-white/90 hover:bg-white hover:border-gray-800 active:bg-gray-50 shadow-sm transition-all duration-300"
            ariaLabel="Demander un devis pour le nettoyage de votre terrasse"
            tracking={{ action: "lead", source: "hero-terrasses", intent: "cta-tertiary" }}
            data={{ service: "devis-nettoyage-terrasses" }}
          >
            Réserver une intervention
          </Button>
        </div>

        <div class="flex flex-wrap items-center gap-6 mt-8 pt-8 border-t border-[#3F8D65]/20 hero-reassurance">
          <div class="flex items-center text-sm text-[#475569] reassurance-item">
            <svg class="w-4 h-4 text-[#3F8D65] mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            Estimation rapide par photos
          </div>
          <div class="flex items-center text-sm text-[#475569] reassurance-item">
            <svg class="w-4 h-4 text-[#3F8D65] mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            Matériel pro & méthode adaptée
          </div>
          <div class="flex items-center text-sm text-[#475569] reassurance-item">
            <svg class="w-4 h-4 text-[#3F8D65] mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            Intervention planifiée rapidement
          </div>
        </div>
      </div>

      <div class="order-2 lg:order-2 hero-image">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-[#3F8D65]/10 to-transparent rounded-2xl floating-shape" aria-hidden="true"></div>
          <div class="relative bg-white rounded-2xl shadow-xl overflow-hidden">
            <Image
              src={heroTerrassesImage}
              alt="Terrasse remise au propre après un nettoyage adapté au revêtement extérieur"
              formats={["avif", "webp", "jpeg"]}
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              quality={88}
              loading="eager"
              class="w-full aspect-[4/3] lg:aspect-[5/4] object-cover transition-transform duration-700 hover:scale-105"
            />
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="absolute top-0 right-0 w-64 h-64 bg-[#3F8D65]/5 rounded-full blur-3xl floating-shape" aria-hidden="true"></div>
</section>

<!-- SAVOIR-FAIRE -->
<section
  id="savoir-faire"
  class="bg-white py-12 md:py-20 border-t border-[#E5E7EB]"
  data-activate-floating-cta
  data-hide-header-cta
>
  <div class="container mx-auto px-6 lg:px-12">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8 md:mb-12">
        <div class="inline-flex items-center gap-2 mb-4 px-4 py-2 rounded-full bg-[#3F8D65]/10 text-[#3F8D65] text-sm font-semibold tracking-wide">
          Notre expérience terrain
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1E2939] mb-5 leading-tight">
          Une terrasse plus nette, sans abîmer le revêtement
        </h2>
      </div>

      <div class="max-w-3xl mx-auto mb-10 text-[#475569] text-base md:text-lg leading-relaxed">
        <p class="mb-6">
          Sur une terrasse, le “sale” n’est pas toujours visible au premier regard : biofilm (algues/lichens),
          traces noires, zones de passage qui foncent, taches grasses (barbecue/repas) ou coulures.
          Le bon résultat vient surtout du <strong>diagnostic du support</strong> et du choix d’une méthode adaptée.
        </p>

        <p class="mb-6">
          Chez Klinova, nous privilégions une combinaison <strong>action mécanique contrôlée</strong> (brossage / monobrosse)
          et <strong>produits adaptés</strong> (neutres, alcalins ou spécifiques selon le matériau), avec un <strong>rinçage maîtrisé</strong>
          pour limiter les résidus et préserver les joints. La méthode dépend du matériau, de l’état de surface et de l’exposition (UV, humidité, pollution).
        </p>

        <div class="bg-[#3F8D65]/5 border-l-4 border-[#3F8D65] p-6 rounded-r-lg mb-6">
          <p class="text-[#1E2939]">
            <strong>Rappel “safe” :</strong> sur pierre naturelle poreuse, on évite les produits acides ou décapants agressifs.
            L’objectif est une terrasse <strong>plus propre et plus sûre</strong>, sans promesse d’uniformité parfaite sur des supports anciens ou abimés.
          </p>
        </div>

        <p>
          Selon le cas, un <strong>démoussage</strong> ou un traitement anti-algues peut être proposé : l’action est progressive,
          et l’efficacité dépend du support, de l’exposition et de la météo. En option, une <strong>protection</strong> (hydrofuge / anti-tache)
          peut aider à limiter l’absorption et faciliter l’entretien.
        </p>
      </div>

      <div class="border-t border-[#E5E7EB] pt-10 mb-10">
        <h3 class="text-xl font-semibold text-[#1E2939] text-center mb-8">
          Revêtements & contextes traités
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h4 class="text-lg font-semibold text-[#3F8D65] mb-3">Revêtements courants</h4>
            <ul class="space-y-2 text-[#475569] text-sm md:text-base">
              <li>Béton (brut, lissé, dalles)</li>
              <li>Carrelage extérieur / grès cérame</li>
              <li>Pierre naturelle (travertin, calcaire) / reconstituée</li>
              <li>Bois / bois composite (WPC)</li>
              <li>Pavés / dallage extérieur</li>
            </ul>
          </div>

          <div>
            <h4 class="text-lg font-semibold text-[#3F8D65] mb-3">Problèmes fréquents</h4>
            <ul class="space-y-2 text-[#475569] text-sm md:text-base">
              <li>Mousses, algues, lichens (biofilm)</li>
              <li>Traces noires (pollution, ruissellement, humidité)</li>
              <li>Taches grasses (barbecue, repas)</li>
              <li>Tanins (feuilles), coulures, rouille</li>
              <li>Zones de passage qui foncent</li>
            </ul>
          </div>

          <div>
            <h4 class="text-lg font-semibold text-[#3F8D65] mb-3">Contextes d’usage</h4>
            <ul class="space-y-2 text-[#475569] text-sm md:text-base">
              <li>Maison : terrasse, cour, accès extérieur</li>
              <li>Copropriété : cours, circulations, terrasses communes</li>
              <li>Petits pros : terrasse de proximité (selon configuration)</li>
              <li>Avant vente / location : présentation plus nette</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="text-center pt-8 border-t border-[#E5E7EB]">
        <p class="text-[#475569] text-sm md:text-base mb-2">
          <span class="font-semibold text-[#1E2939]">Intervention en Île-de-France</span><br />
          Paris • Hauts-de-Seine • Seine-Saint-Denis • Val-de-Marne • Val-d’Oise •
          Seine-et-Marne • Yvelines • Essonne
        </p>

        <a
          href="#formulaire"
          class="inline-flex items-center mt-6 px-6 py-3 bg-white border border-gray-300 hover:bg-gray-50 hover:border-gray-400 text-gray-800 font-semibold rounded-lg transition-all duration-200 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-gray-500/30 shadow-md hover:shadow-lg"
        >
          Demander un devis de nettoyage de terrasse
          <svg class="w-5 h-5 ml-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

