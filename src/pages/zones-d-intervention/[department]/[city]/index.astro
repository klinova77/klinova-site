---
import type { ServiceConfig } from "~/types/geo";

import LayoutWithCTA from "~/layouts/LayoutWithCTA.astro";

import cities from "~/data/cities";
import services from "~/data/services";

import { PHONE_DISPLAY, PHONE_E164, toTelHref } from "~/lib/phone";
import { getExperienceYears } from "~/lib/company";

import Button from "~/components/UI/Button.astro";

import { aVille, deVille } from "~/lib/geo-klinova";


/* -------------------------------------------------------------------------- */
/* Helpers                                                                    */
/* -------------------------------------------------------------------------- */

const slugify = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "");


/* -------------------------------------------------------------------------- */
/* Génération statique                                                        */
/* -------------------------------------------------------------------------- */

export const prerender = true;

export async function getStaticPaths() {
  return cities
    .filter(
      (city) =>
        city?.name &&
        city?.department
    )
    .map((city) => {
      const departmentSlug =
        city.department.slug ??
        slugify(city.department.name);

      const citySlug =
        city.slug ??
        slugify(city.name);

      return {
        params: {
          department: departmentSlug,
          city: citySlug,
        },

        props: {
          department: city.department,
          city,
        },
      };
    });
}


/* -------------------------------------------------------------------------- */
/* Configuration générale                                                     */
/* -------------------------------------------------------------------------- */

const site = (
  import.meta.env.SITE ??
  "https://klinova.fr"
).replace(/\/$/, "");

const experienceYears =
  getExperienceYears();


/* -------------------------------------------------------------------------- */
/* Ville et département courants                                              */
/* -------------------------------------------------------------------------- */

const {
  department: currentDepartment,
  city: currentCity,
} = Astro.props;

const departmentSlug =
  currentDepartment.slug ??
  slugify(currentDepartment.name);

const citySlug =
  currentCity.slug ??
  slugify(currentCity.name);

const cityName =
  currentCity.name;

const cityAt =
  aVille(cityName);

const cityFrom =
  deVille(cityName);

const departmentName =
  currentCity.department?.name ??
  "Île-de-France";


/* -------------------------------------------------------------------------- */
/* URL                                                                        */
/* -------------------------------------------------------------------------- */

const canonical =
  `/zones-d-intervention/${departmentSlug}/${citySlug}`;

const pageUrl =
  `${site}${canonical}`;


/* -------------------------------------------------------------------------- */
/* Services affichés pour cette ville                                         */
/* -------------------------------------------------------------------------- */

const cityServiceKeys =
  new Set(
    (currentCity.services ?? [])
      .map((service) => service.serviceKey)
  );

const SERVICE_ORDER = [
  "moquettes",
  "nettoyage-appartement-maison",
  "balcons",
  "balcons-fientes",
  "terrasses",
  "canapes-tapis",
  "parkings",
];

const servicesForCity =
  (Array.isArray(services) ? services : [])
    .filter(
      (service): service is ServiceConfig =>
        !!service &&
        typeof (service as any).key === "string"
    )
    .filter(
      (service) =>
        typeof service.urls?.parent === "string" &&
        service.urls.parent.length > 0
    )
    .filter(
      (service) =>
        cityServiceKeys.has(service.key)
    )
    .sort((a, b) => {
      const indexA =
        SERVICE_ORDER.indexOf(a.key);

      const indexB =
        SERVICE_ORDER.indexOf(b.key);

      return (
        (indexA === -1 ? 999 : indexA) -
        (indexB === -1 ? 999 : indexB)
      );
    });

const serviceSlug = (
  service: ServiceConfig
) =>
  service.urls?.parent
    ?.replace(/^\/+/, "") ??
  "";


/* -------------------------------------------------------------------------- */
/* Villes voisines                                                            */
/* -------------------------------------------------------------------------- */

const nearbyCitiesResolved =
  currentCity.nearbyCities &&
  currentCity.nearbyCities.length > 0
    ? currentCity.nearbyCities
        .map((slug) =>
          cities.find(
            (city) =>
              city.slug === slug
          )
        )
        .filter(
          (city): city is (typeof cities)[number] =>
            Boolean(city)
        )
    : [];


/* -------------------------------------------------------------------------- */
/* Helpers département                                                        */
/* -------------------------------------------------------------------------- */

const departmentAreaLabel = (() => {
  const slug =
    currentCity.department?.slug ?? "";

  switch (slug) {
    case "val-de-marne":
      return "du Val-de-Marne";

    case "essonne":
      return "de l'Essonne";

    case "seine-et-marne":
      return "de la Seine-et-Marne";

    case "seine-saint-denis":
      return "de la Seine-Saint-Denis";

    case "hauts-de-seine":
      return "des Hauts-de-Seine";

    case "paris":
      return "de Paris";

    case "yvelines":
      return "des Yvelines";

    default:
      return `du département ${departmentName}`;
  }
})();

const departmentCoproLabel = (() => {
  const slug =
    currentCity.department?.slug ?? "";

  switch (slug) {
    case "paris":
      return "de Paris";

    case "val-de-marne":
      return "du Val-de-Marne";

    case "essonne":
      return "de l'Essonne";

    case "seine-et-marne":
      return "de Seine-et-Marne";

    case "seine-saint-denis":
      return "de Seine-Saint-Denis";

    case "hauts-de-seine":
      return "des Hauts-de-Seine";

    case "yvelines":
      return "des Yvelines";

    default:
      return `du département ${departmentName}`;
  }
})();


/* -------------------------------------------------------------------------- */
/* Stats                                                                      */
/* -------------------------------------------------------------------------- */

const departmentStats: Record<
  string,
  {
    clientsDepartment: number;
  }
> = {
  paris: {
    clientsDepartment: 120,
  },

  "val-de-marne": {
    clientsDepartment: 60,
  },

  "seine-et-marne": {
    clientsDepartment: 80,
  },

  "seine-saint-denis": {
    clientsDepartment: 70,
  },

  "hauts-de-seine": {
    clientsDepartment: 90,
  },

  yvelines: {
    clientsDepartment: 50,
  },
};

const globalSatisfaction =
  "4,9/5";

const clientsDepartment =
  departmentStats[
    currentCity.department?.slug ?? ""
  ]?.clientsDepartment ?? 40;


/* -------------------------------------------------------------------------- */
/* SEO                                                                        */
/* -------------------------------------------------------------------------- */

const postalCode =
  currentCity.postalCodes?.[0] ?? "";

const title =
  `Entreprise de nettoyage ${cityAt} – Klinova`;

const description =
  `Klinova intervient ${cityAt} pour des prestations de nettoyage professionnel auprès des particuliers, copropriétés et entreprises. Devis gratuit et intervention en Île-de-France.`;


/* -------------------------------------------------------------------------- */
/* FAQ ville                                                                  */
/* -------------------------------------------------------------------------- */

const fallbackCityFaq = [
  {
    question:
      "Comment se déroule le premier rendez-vous sur site ?",

    answer:
      `Pour une intervention à <strong>${currentCity.name}</strong>, nous échangeons d’abord sur le besoin, les surfaces à traiter et les contraintes d’accès. Selon la prestation, des photos peuvent suffire pour préparer le devis ou une visite technique peut être proposée.`,
  },

  {
    question:
      `Sous quels délais pouvez-vous intervenir ${cityAt} ?`,

    answer:
      "Les délais dépendent du type de prestation, de la surface et de nos disponibilités. Lors de la demande de devis, nous vous indiquons les créneaux possibles et organisons l’intervention selon vos contraintes.",
  },

  {
    question:
      "Comment gérez-vous les accès aux immeubles et copropriétés ?",

    answer:
      `Les modalités d’accès à <strong>${currentCity.name}</strong> sont définies avant l’intervention : badges, codes, clés, accès parking ou présence d’un gardien selon la configuration du site.`,
  },

  {
    question:
      "Les devis sont-ils payants ?",

    answer:
      `Non. Les demandes de devis pour nos prestations à <strong>${currentCity.name}</strong> sont gratuites et sans engagement.`,
  },
];

const cityFaq =
  currentCity.faq &&
  currentCity.faq.length > 0
    ? currentCity.faq
    : fallbackCityFaq;


/* -------------------------------------------------------------------------- */
/* IDs JSON-LD                                                                */
/* -------------------------------------------------------------------------- */

const webpageId =
  `${pageUrl}#webpage`;

const servicesListId =
  `${pageUrl}#services`;


/* -------------------------------------------------------------------------- */
/* Liste des services disponibles                                             */
/* -------------------------------------------------------------------------- */

/**
 * On ne crée pas de nouveaux Service spécifiques à la ville.
 *
 * On référence les véritables Service définis sur les pages
 * principales de Klinova :
 *
 * /nettoyage-moquettes#service
 * /nettoyage-balcons#service
 * etc.
 */
const servicesListLd = {
  "@type": "ItemList",

  "@id":
    servicesListId,

  name:
    `Services de nettoyage Klinova ${cityAt}`,

  numberOfItems:
    servicesForCity.length,

  itemListElement:
    servicesForCity.map(
      (
        service: ServiceConfig,
        index: number
      ) => ({
        "@type": "ListItem",

        position:
          index + 1,

        item: {
          "@id":
            `${site}${service.urls.parent}#service`,
        },
      })
    ),
};


/* -------------------------------------------------------------------------- */
/* CollectionPage ville                                                       */
/* -------------------------------------------------------------------------- */

const webPageLd = {
  "@type":
    "CollectionPage",

  "@id":
    webpageId,

  url:
    pageUrl,

  name:
    title,

  description,

  isPartOf: {
    "@id":
      `${site}#website`,
  },

  about: {
    "@id":
      `${site}#organization`,
  },

  publisher: {
    "@id":
      `${site}#organization`,
  },

  mainEntity: {
    "@id":
      servicesListId,
  },

  spatialCoverage: {
    "@type":
      "City",

    name:
      currentCity.name,

    containedInPlace: {
      "@type":
        "AdministrativeArea",

      name:
        departmentName,
    },
  },

  inLanguage:
    "fr-FR",
};


/* -------------------------------------------------------------------------- */
/* BreadcrumbList                                                             */
/* -------------------------------------------------------------------------- */

const breadcrumbLd = {
  "@type":
    "BreadcrumbList",

  itemListElement: [
    {
      "@type":
        "ListItem",

      position:
        1,

      name:
        "Accueil",

      item:
        `${site}/`,
    },

    {
      "@type":
        "ListItem",

      position:
        2,

      name:
        "Zones d’intervention",

      item:
        `${site}/zones-d-intervention`,
    },

    {
      "@type":
        "ListItem",

      position:
        3,

      name:
        departmentName,

      item:
        `${site}/zones-d-intervention/${departmentSlug}`,
    },

    {
      "@type":
        "ListItem",

      position:
        4,

      name:
        currentCity.name,

      item:
        pageUrl,
    },
  ],
};


/* -------------------------------------------------------------------------- */
/* FAQPage                                                                    */
/* -------------------------------------------------------------------------- */

const faqLd = {
  "@type":
    "FAQPage",

  mainEntity:
    cityFaq
      .slice(0, 5)
      .map((item) => ({
        "@type":
          "Question",

        name:
          item.question,

        acceptedAnswer: {
          "@type":
            "Answer",

          text:
            item.answer
              .replace(/<[^>]*>/g, "")
              .trim(),
        },
      })),
};


/* -------------------------------------------------------------------------- */
/* JSON-LD                                                                    */
/* -------------------------------------------------------------------------- */

const jsonLd = [
  webPageLd,
  servicesListLd,
  breadcrumbLd,
  faqLd,
];


/* -------------------------------------------------------------------------- */
/* Hero                                                                       */
/* -------------------------------------------------------------------------- */

const customDescription =
  currentCity.customDescription ??
  `Klinova intervient ${cityAt} pour des prestations de nettoyage professionnel auprès des particuliers, copropriétés et entreprises. Les méthodes et équipements sont adaptés à la nature des surfaces et au besoin de chaque intervention.`;

const phoneHref =
  toTelHref(PHONE_E164);
---

<LayoutWithCTA
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  popupContext={{
    title: 'Demander un devis',
    subtitle: `Intervention ${cityAt}.`,
    serviceKey: 'city-hub',
    serviceLabel: `Hub ville – ${currentCity.name}`,
    trackingSource: `hub-${currentCity.slug}`,
  }}
>

  <nav aria-label="Fil d'Ariane" class="bg-white border-b border-neutral-200">
    <div class="container-responsive py-3">
      <ol class="flex flex-wrap gap-2 text-sm text-neutral-600">
        <li>
          <a href="/" class="hover:text-primary-600 transition-colors">
            Accueil
          </a>
        </li>
        <li aria-hidden="true" class="text-neutral-400">/</li>

        <li>
          <a
            href="/zones-d-intervention"
            class="hover:text-primary-600 transition-colors"
          >
            Zones d'intervention
          </a>
        </li>
        <li aria-hidden="true" class="text-neutral-400">/</li>

        <li>
          <a
            href={`/zones-d-intervention/${departmentSlug}`}
            class="hover:text-primary-600 transition-colors"
          >
            {departmentName}
          </a>
        </li>
        <li aria-hidden="true" class="text-neutral-400">/</li>

        <li aria-current="page" class="font-medium text-primary-600">
          {currentCity.name}
        </li>
      </ol>
    </div>
  </nav>






  <main class="bg-white">
    <!--HERO LOCAL -->




<section class="relative pt-20 pb-16 lg:pt-28 lg:pb-24 border-b border-neutral-100/80 overflow-hidden bg-gradient-to-b from-white to-[#FCFCFC]"
 data-hide-floating-cta
data-hide-header-cta 
>
  
  <!--Motif de fond sophistiqué et subtil -->
  <div class="absolute inset-0 opacity-[0.015] pointer-events-none" aria-hidden="true">
    <svg class="w-full h-full" viewBox="0 0 120 120" preserveAspectRatio="none">
      <defs>
        <pattern id="premium-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <circle cx="20" cy="20" r="1" fill="#1E2939" opacity="0.3"/>
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1E2939" stroke-width="0.3" opacity="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#premium-grid)"/>
    </svg>
  </div>

  <!--Éléments décoratifs pour la profondeur -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-bl from-[#3F8D65]/100 to-transparent rounded-full blur-3xl -translate-y-48 translate-x-48 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-gradient-to-tr from-[#DFF1E8]/100 to-transparent rounded-full blur-2xl translate-y-32 -translate-x-32 pointer-events-none" aria-hidden="true"></div>

  <div class="container-responsive hero-city-anim relative z-10">
 
    
    <!--Badge premium avec animation subtile -->
    <div class="flex justify-center mb-8">
      <div class="group relative inline-flex items-center gap-3 px-4 py-2 bg-white border border-[#C0E2D0]/60 rounded-full shadow-sm hover:shadow-md transition-all duration-300 hover:border-[#3F8D65]/40">
        <div class="relative flex items-center">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#3F8D65] opacity-40"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#3F8D65]"></span>
          </span>
        </div>
        <span class="text-sm font-semibold tracking-wide text-[#1E2939]">
          Service actif à <span class="text-[#3F8D65]">{cityName}</span>
          {postalCode && <span class="text-[#64748B] ml-1">({postalCode})</span>}
        </span>
      </div>
    </div>

    <!--Contenu principal centré -->
    <div class="text-center max-w-5xl mx-auto">
      
      <!--H1 avec typographie raffinée -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-[#1E2939] mb-6 leading-[1.1] tracking-tight">
        <span class="block">Entreprise de nettoyage</span>
        <span class="block text-[#3F8D65] relative">
          {cityAt}
          <span class="absolute -bottom-2 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#3F8D65]/20 to-transparent rounded-full"></span>
        </span>
      </h1>

      <!--Sous-titre premium -->
      <div class="mb-8">
        <p class="text-xl md:text-2xl text-[#475569] font-medium mb-4 leading-relaxed max-w-3xl mx-auto">
          Pour copropriétés, parkings, bureaux et particuliers
        </p>
        
        <!--Description contextualisée avec meilleur spacing -->
        <div class="relative">
          <div class="w-16 h-px bg-gradient-to-r from-transparent via-[#E5E7EB] to-transparent mx-auto mb-6"></div>
          <p class="text-lg text-[#64748B] max-w-4xl mx-auto leading-relaxed">
            {customDescription}
          </p>
        </div>
      </div>

      <!--CTAs avec design premium -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-12">
       <Button
  href="/contact#formulaire"
  label="Demander un devis gratuit"
  variant="primary"
  size="lg"
  class="group relative inline-flex items-center justify-center px-10 py-5 text-base md:text-lg font-semibold text-white transition-all duration-300 bg-[#3F8D65] border border-transparent rounded-full hover:bg-[#387B58] hover:shadow-lg hover:shadow-[#3F8D65]/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#3F8D65] transform hover:-translate-y-0.5"
  tracking={{
    action: 'cta_click',
    source: `hub-hero-${currentCity.slug}`,
    intent: 'contact',
    campaign: 'city-hub',
  }}
>
  <span class="relative z-10">Demander un devis gratuit</span>
  <div class="absolute inset-0 bg-gradient-to-r from-[#3F8D65] to-[#387B58] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
</Button>


  <Button
  href={phoneHref}
  label={`Appeler ${PHONE_DISPLAY}`}
  variant="secondary"
  size="lg"
  class="group inline-flex items-center justify-center px-10 py-5 text-base md:text-lg font-semibold text-[#1E2939] transition-all duration-300 bg-white border border-neutral-200 rounded-full hover:bg-neutral-50 hover:border-[#3F8D65]/30 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-500 transform hover:-translate-y-0.5"
  tracking={{
    action: 'cta_click',
    source: `hub-hero-${currentCity.slug}`,
    intent: 'phone',
    campaign: 'city-hub',
  }}
>
  <svg
    class="w-5 h-5 mr-3 -ml-1 text-[#3F8D65] transition-transform duration-300 group-hover:scale-110"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
    />
  </svg>
  <span class="relative z-10">{PHONE_DISPLAY}</span>
</Button>

      </div>

      <!--Éléments de confiance redessinés avec plus d'élégance -->
      <div class="relative">
        <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-4 text-sm md:text-base">
          
          <div class="group flex items-center gap-3 transition-all duration-300 hover:scale-105">
            <div class="relative">
              <div class="absolute inset-0 bg-[#3F8D65] rounded-full blur-md opacity-20 group-hover:opacity-40 transition-opacity duration-300"></div>
              <span class="relative inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#DFF1E8] border border-[#C0E2D0] group-hover:bg-[#3F8D65] group-hover:border-[#3F8D65] transition-all duration-300">
                <span class="text-sm font-bold text-[#3F8D65] group-hover:text-white transition-colors duration-300">✓</span>
              </span>
            </div>
            <span class="font-medium text-[#475569] group-hover:text-[#1E2939] transition-colors duration-300">
              Particuliers & Professionnels
            </span>
          </div>

          <div class="group flex items-center gap-3 transition-all duration-300 hover:scale-105">
            <div class="relative">
              <div class="absolute inset-0 bg-[#3F8D65] rounded-full blur-md opacity-20 group-hover:opacity-40 transition-opacity duration-300"></div>
              <span class="relative inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#DFF1E8] border border-[#C0E2D0] group-hover:bg-[#3F8D65] group-hover:border-[#3F8D65] transition-all duration-300">
                <span class="text-sm font-bold text-[#3F8D65] group-hover:text-white transition-colors duration-300">✓</span>
              </span>
            </div>
            <span class="font-medium text-[#475569] group-hover:text-[#1E2939] transition-colors duration-300">
              Interventions 7j/7
            </span>
          </div>

          <div class="group flex items-center gap-3 transition-all duration-300 hover:scale-105">
            <div class="relative">
              <div class="absolute inset-0 bg-[#3F8D65] rounded-full blur-md opacity-20 group-hover:opacity-40 transition-opacity duration-300"></div>
              <span class="relative inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#DFF1E8] border border-[#C0E2D0] group-hover:bg-[#3F8D65] group-hover:border-[#3F8D65] transition-all duration-300">
                <span class="text-sm font-bold text-[#3F8D65] group-hover:text-white transition-colors duration-300">✓</span>
              </span>
            </div>
            <span class="font-medium text-[#475569] group-hover:text-[#1E2939] transition-colors duration-300">
              Devis sous 24h
            </span>
          </div>

        </div>

        <!--Ligne décorative finale -->
        <div class="mt-8 flex justify-center">
          <div class="w-24 h-px bg-gradient-to-r from-transparent via-[#3F8D65]/30 to-transparent"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Animation pour les éléments au scroll (optionnel) */
@media (prefers-reduced-motion: no-preference) {
  .hero-city-anim > * {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  
  .hero-city-anim > *:nth-child(1) { animation-delay: 0.1s; }
  .hero-city-anim > *:nth-child(2) { animation-delay: 0.2s; }
  .hero-city-anim > *:nth-child(3) { animation-delay: 0.3s; }
}


  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Micro-interactions premium */
  .group:hover .animate-ping {
    animation-duration: 0.75s;
  }
</style>

<!--Section Stats Locales (Version Efficace) -->
<section class="py-8 bg-[#F8FAFC] border-b border-neutral-200"
 data-hide-floating-cta
data-hide-header-cta 
>

  <div class="container-responsive">
    
    <div class="grid grid-cols-3 divide-x divide-neutral-200">
      
      <!--1. Satisfaction (globale) -->
      <div class="px-4 text-center">
        <div class="text-2xl md:text-3xl font-bold text-[#1E2939] mb-1 flex justify-center items-center gap-1">
          {globalSatisfaction}
          <span class="text-amber-400 text-xl">★</span>
        </div>
        <p class="text-xs md:text-sm font-medium text-[#64748B] uppercase tracking-wide">
          Satisfaction client
