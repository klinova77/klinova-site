---
// D:\Klinova-site\src\pages\zones-d-intervention\[department]\[city]\[service].astro
export const prerender = true;
import CityPage from '~/components/CityPage.astro'; // ⬅️ ton composant CityPage (celui dont tu as collé le code)
import { generateCityPaths } from '~/utils/generate-city-pages';
import type { City, ServiceConfig } from '~/types/geo';

import { FEATURED_CITY_SLUGS, FOOTER_CITY_SLUGS } from "~/data/highlightedCities";




type Params = {
  department: string;
  city: string;
  service: string;
};

export async function getStaticPaths() {
  // Génère: /zones-d-intervention/{department}/{city}/{service}
  // props: { department, city, service } déjà prêts pour CityPage
  return generateCityPaths();
}

// Les props sont injectés par getStaticPaths()
const {
  department,
  city,
  service,
} = Astro.props as {
  department: { name: string; code?: string; slug: string };
  city: City;
  service: ServiceConfig;
};

const showReviewsWidget =
  FEATURED_CITY_SLUGS.includes(city.slug as any) ||
  FOOTER_CITY_SLUGS.includes(city.slug as any);

---

<!-- On délègue l'affichage à ton composant CityPage en lui passant les props -->
<CityPage department={department} city={city} service={service}  showReviewsWidget={showReviewsWidget}/>

